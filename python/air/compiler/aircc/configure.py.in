import os

air_link_with_xchesscc = @CONFIG_LINK_WITH_XCHESSCC@
air_compile_with_xchesscc = @CONFIG_COMPILE_WITH_XCHESSCC@

def install_path():
    path = os.path.dirname(os.path.realpath(__file__))
    path = os.path.join(path, '..', '..', '..', '..')
    return os.path.realpath(path)
