// RUN: air-opt %s | FileCheck %s

// CHECK: transform.air.hoist_loop_invariant_reads

module attributes {transform.with_named_sequence} {
  transform.named_sequence @__transform_main(%arg1: !transform.any_op {transform.readonly}) {
    %f = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %f2 = transform.air.hoist_loop_invariant_reads %f : (!transform.any_op) -> !transform.any_op
    transform.yield
  }
}
