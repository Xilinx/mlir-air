srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

PYTHON ?= $(if $(filter Windows_NT,$(OS)),python,python3)

# Tile sizes. A launch point computes one TILE_M x TILE_N block of C; each core
# of the column takes one BLOCK_K step of K.
TILE_M ?= 32
TILE_N ?= 32
BLOCK_K ?= 256

# The matmul is generated by direct codegen, so there is no kernel to compile
# and no Chess path.
BUILD_DIR := build_peano
export PEANO_INSTALL_DIR

# AIE_TARGET is accepted for symmetry with the bf16 example, but aie2p is the
# only legal value; run.py rejects aie2 with a diagnostic.
# COMPILE_MODE can be 'compile-and-run' (default), 'compile-and-xclbin', or
# 'compile-only'.
# Usage examples:
#   make run                             # 128x128x960: three full K steps and one of 192
#   make run K=1024                      # no partial step
#   make run COMPILE_MODE=compile-only   # no XRT needed
AIE_TARGET ?= aie2p
COMPILE_MODE ?= compile-and-run

M ?= 128
N ?= 128
K ?= 960

COMMON_ARGS = --tile-m $(TILE_M) --tile-n $(TILE_N) --block-k $(BLOCK_K) --compile-mode $(COMPILE_MODE) --arch $(AIE_TARGET)

all: run

print:
	${powershell} $(PYTHON) ${srcdir}/run.py -p --m $(M) --n $(N) --k $(K) \
		--tile-m $(TILE_M) --tile-n $(TILE_N) --block-k $(BLOCK_K) --arch $(AIE_TARGET)

run: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(M) --n $(N) --k $(K) \
		$(COMMON_ARGS)

# Four full K steps: the same design with no padding.
run_k1024: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(M) --n $(N) --k 1024 \
		$(COMMON_ARGS)

# Three K steps, the last one 192 deep.
run_3step: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(M) --n $(N) --k 704 \
		$(COMMON_ARGS)

# The longest pad the memtile can add here: 15 blocks of 8 (last step 136).
run_maxpad: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(M) --n $(N) --k 904 \
		$(COMMON_ARGS)

# A single launch point.
run1x1: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(TILE_M) --n $(TILE_N) --k $(K) \
		$(COMMON_ARGS)

# Report latency + GFLOPs alongside the correctness check.
profile: build-dir
	cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m 512 --n 512 --k $(K) \
		--perf-iters 50 $(COMMON_ARGS)

# Measure the e2e latencies across ragged and whole K.
sweep: build-dir
	@for K in 704 768 904 960 1024; do \
		echo "Running with M=$(M), N=$(N), K=$$K"; \
		cd $(BUILD_DIR) && ${powershell} $(PYTHON) ${srcdir}/run.py --m $(M) --n $(N) --k $$K \
			--perf-iters 20 $(COMMON_ARGS); \
		cd ..; \
	done

build-dir:
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR) __pycache__

.PHONY: all print run run_k1024 run_3step run_maxpad run1x1 profile sweep build-dir clean
