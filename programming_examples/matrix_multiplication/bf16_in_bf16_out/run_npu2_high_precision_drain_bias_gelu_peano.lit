// REQUIRES: ryzen_ai_npu2, peano
//
// Drain GEMM with an epilogue: bias + GELU(tanh) in the drain cast (f32_to_bf16_bias_gelu_mn).
// The Makefile builds mm.o with -DDIM_K_PAD when B_PAD_ROWS > 0.
// RUN: mkdir -p test_npu2_high_precision_drain_bias_gelu_peano
// RUN: cd test_npu2_high_precision_drain_bias_gelu_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain B_PAD_ROWS=8 EPILOGUE_GELU=true M=1024 K=768 N=768 TILE_M=32 TILE_K_L2=384 TILE_K_L1=64 TILE_N=96 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
