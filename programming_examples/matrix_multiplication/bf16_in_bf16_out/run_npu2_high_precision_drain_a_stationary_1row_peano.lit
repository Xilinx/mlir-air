// REQUIRES: ryzen_ai_npu2, peano
//
// A-stationary on a one-row herd: the C gather's scf.parallel is awaited by the
// put that sends C on, so it has to stay in that put's loop.
// RUN: mkdir -p test_npu2_high_precision_drain_a_stationary_1row_peano
// RUN: cd test_npu2_high_precision_drain_a_stationary_1row_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain A_STATIONARY=true M=32 K=768 N=1024 TILE_M=32 TILE_K_L2=256 TILE_K_L1=64 TILE_N=64 HERD_M=1 HERD_N=4 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
