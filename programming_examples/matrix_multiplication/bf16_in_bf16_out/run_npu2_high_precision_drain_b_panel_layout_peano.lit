// REQUIRES: ryzen_ai_npu2, peano
//
// Panel-layout B, composed with B-stationary: each (K-chunk, N-launch-block) slab of
// weights is one dense contiguous DRAM run instead of TILE_K_L2 separate TILE_N-element
// bursts, so the L3->L2 DMA becomes one burst per panel. Bit-identical to b_stationary alone.
// RUN: mkdir -p test_npu2_high_precision_drain_b_panel_layout_peano
// RUN: cd test_npu2_high_precision_drain_b_panel_layout_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain B_STATIONARY=true B_PANEL_LAYOUT=true M=1024 K=768 N=768 TILE_M=32 TILE_K_L2=768 TILE_K_L1=64 TILE_N=96 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
