// REQUIRES: ryzen_ai_npu2, peano
//
// A-stationary with 17 N trips per launch (4352 / (64 * 4)): the L2 A tile is
// filled once and re-sent 17 times per K chunk.
// RUN: mkdir -p test_npu2_high_precision_drain_a_stationary_17trips_peano
// RUN: cd test_npu2_high_precision_drain_a_stationary_17trips_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain A_STATIONARY=true M=256 K=1152 N=4352 TILE_M=32 TILE_K_L2=128 TILE_K_L1=32 TILE_N=64 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
