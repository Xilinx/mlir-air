// REQUIRES: ryzen_ai_npu2, peano
//
// A-stationary with one K chunk (TILE_K_L2 == K) on a single core: the core computes
// and drains its C tile once per N trip, so the drain must stay ordered after the
// compute herd inside the N loop.
// RUN: mkdir -p test_npu2_high_precision_drain_a_stationary_1kchunk_peano
// RUN: cd test_npu2_high_precision_drain_a_stationary_1kchunk_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain A_STATIONARY=true M=64 K=768 N=128 TILE_M=32 TILE_K_L2=768 TILE_K_L1=64 TILE_N=64 HERD_M=1 HERD_N=1 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
