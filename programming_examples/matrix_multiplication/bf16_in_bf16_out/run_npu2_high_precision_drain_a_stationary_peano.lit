//
// REQUIRES: ryzen_ai_npu2, peano
//
// A-stationary drain GEMM: M stays a launch dimension, the activation tile (whole K) is
// filled once per launch and the N tiles loop inside the segment, re-reading it 2 times
// while B streams in 3 K chunks.
// RUN: mkdir -p test_npu2_high_precision_drain_a_stationary_peano
// RUN: cd test_npu2_high_precision_drain_a_stationary_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain A_STATIONARY=true M=256 K=768 N=768 TILE_M=32 TILE_K_L2=256 TILE_K_L1=64 TILE_N=96 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
