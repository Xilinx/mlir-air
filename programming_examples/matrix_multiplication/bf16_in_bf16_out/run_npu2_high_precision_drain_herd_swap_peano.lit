// REQUIRES: ryzen_ai_npu2, peano
//
// Swapped-herd drain GEMM: M on the herd's 4 core rows, N on its 8 columns (same 32 cores),
// B-stationary, at SmolVLA's O-projection tile (64x48x64).
// RUN: mkdir -p test_npu2_high_precision_drain_herd_swap_peano
// RUN: cd test_npu2_high_precision_drain_herd_swap_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain B_STATIONARY=true HERD_SWAP=true HERD_M=4 HERD_N=8 M=1024 K=768 N=768 TILE_M=64 TILE_K_L2=768 TILE_K_L1=64 TILE_N=48 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
