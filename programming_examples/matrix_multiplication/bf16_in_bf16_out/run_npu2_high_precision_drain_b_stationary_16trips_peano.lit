// REQUIRES: ryzen_ai_npu2, peano
//
// B-stationary with 16 M trips per launch (4096 / (32 * 8)): the L2 B tile is filled
// once and re-sent 16 times, so its memtile lock must count 16 (it hung at 16+).
// RUN: mkdir -p test_npu2_high_precision_drain_b_stationary_16trips_peano
// RUN: cd test_npu2_high_precision_drain_b_stationary_16trips_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run HIGH_PRECISION=true METHOD=drain B_STATIONARY=true M=4096 K=1024 N=768 TILE_M=32 TILE_K_L2=1024 TILE_K_L1=64 TILE_N=96 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR AIE_TARGET=aie2p | FileCheck %s
// CHECK: PASS!
