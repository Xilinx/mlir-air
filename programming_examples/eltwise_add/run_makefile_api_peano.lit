//
// air.api version on npu1: both ranks, both dtypes. f32 uses the dtype's
// default vector width (16 lanes / 512-bit); 8 lanes does not legalize on AIE2.
//
// REQUIRES: ryzen_ai, peano
//
// RUN: mkdir -p api_test_peano
// RUN: cd api_test_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run AIE_TARGET=aie2 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR API_DTYPE=f32 | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 API_DTYPE=f32 API_VECTOR_SIZE=0 | FileCheck %s
// CHECK: PASS!
