//
// air.api version on npu2: both ranks, both dtypes, plus the bandwidth harness
// at the same 1-D shape the raw-bindings version profiles.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p api_test_peano_npu2
// RUN: cd api_test_peano_npu2
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run AIE_TARGET=aie2p PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2p PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2p PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR API_DTYPE=f32 | FileCheck %s
// RUN: make -f %S/Makefile run AIE_TARGET=aie2p PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 API_DTYPE=f32 | FileCheck %s
// RUN: make -f %S/Makefile profile AIE_TARGET=aie2p PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=4194304 TILE=2048 | FileCheck --check-prefix=PROFILE %s
// CHECK: PASS!
// PROFILE: PASS
