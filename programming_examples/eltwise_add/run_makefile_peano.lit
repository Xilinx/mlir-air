//
// Runs on whichever NPU is installed: both ranks, both dtypes. The herd sizes
// itself for the detected generation. f32 uses the dtype's default vector width
// (16 lanes / 512-bit); 8 lanes does not legalize on AIE2.
//
// REQUIRES: ryzen_ai, peano
//
// RUN: mkdir -p test_peano
// RUN: cd test_peano
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
// RUN: make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 | FileCheck %s
// RUN: make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR DTYPE=f32 | FileCheck %s
// RUN: make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR SHAPE=65536 DTYPE=f32 VECTOR_SIZE=0 | FileCheck %s
// CHECK: PASS!
