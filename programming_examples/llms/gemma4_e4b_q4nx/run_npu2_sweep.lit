//
// GEMMA4-E4B Q4NX decode throughput vs KV depth, into gemma4_e4b_q4nx.sweep.json
// (collected by the nightly LLM benchmark). Each point rebuilds the full
// 42-layer template pair. Synthetic and latency-only, so no weights needed.
//
// The list stops at 32k: two kv heads double E2B's KV per token, so 128k would
// need too much pinned host memory.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, llvm_link_pre23
//
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode.py --model-name gemma4_e4b_q4nx --makefile %S/Makefile --template-dir %S --bench-model gemma4-e4b --vocab-chunk-i2 5 --n-layers 42 --contexts 2048,8192,32768 --peano-dir %PEANO_INSTALL_DIR --xrt-dir %XRT_DIR --out gemma4_e4b_q4nx.sweep.json
// RUN: FileCheck %s < gemma4_e4b_q4nx.sweep.json
// CHECK: "model": "gemma4_e4b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 2048
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
