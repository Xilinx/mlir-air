//
// GEMMA4-E4B Q4NX profiling: fused prefill + the 42-layer fused decode, end to
// end, captured into gemma4_e4b_q4nx.perf.json by bench/extract_perf.py
// (collected by the nightly LLM benchmark). `make profile` runs with
// --ignore-eos: like E2B, this model answers short prompts in a few tokens, and
// a tok/s taken from a run that honours the stop measures per-call setup.
// Latency only; `make run` is what gates the text.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_gemma4_e4b_it_npu2
//
// RUN: mkdir -p test_npu2_profile
// RUN: cd test_npu2_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-decode-full PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile profile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR N_TOKENS=64 PROMPT="What is the capital of France?" | tee profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model gemma4_e4b_q4nx > gemma4_e4b_q4nx.perf.json
// RUN: FileCheck %s < gemma4_e4b_q4nx.perf.json
// CHECK: "model": "gemma4_e4b_q4nx"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
