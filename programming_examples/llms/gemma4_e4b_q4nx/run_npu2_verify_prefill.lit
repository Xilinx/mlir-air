//
// GEMMA4-E4B Q4NX per-op prefill correctness gate: the whole logit vector
// against the CPU reference (gemma4_e2b_q4nx_weights.forward_prompt with
// the E4B config), plus the ' Paris' argmax.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_gemma4_e4b_it_npu2
//
// RUN: mkdir -p test_npu2_verify_prefill
// RUN: cd test_npu2_verify_prefill
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
//
// CHECK: *** PARIS ***
// CHECK: logit cosine vs CPU reference = 0.{{[0-9]+}}
// CHECK: GATE PASS
