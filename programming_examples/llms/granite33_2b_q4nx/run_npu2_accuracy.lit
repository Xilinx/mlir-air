//
// granite33_2b_q4nx accuracy: teacher-forced PPL + KL divergence of the NPU decode and
// prefill paths against the pinned HF bf16 checkpoint and against it with the
// logical affine-Q4 weights dequantized, on wikitext-2 (verify/accuracy.py).
// Informational: this checks only that the measurement ran; run_npu2_verify.lit
// is the gate. The P1024 configuration's KV capacity covers the 2048-token
// chunks. Collected by check-programming-examples-llms-accuracy.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_ibm_granite_granite_3_3_2b_instruct, hfweights_ggml_org_ci
//
// RUN: test -f affine-build/weights/manifest.json || make -f %S/Makefile weights BUILD_DIR=affine-build PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile P=1024 BUILD_DIR=affine-build PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy BUILD_DIR=affine-build ACC_REF=bf16 ACC_PATH=decode ACC_JSON=granite33_2b_q4nx.bf16.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy BUILD_DIR=affine-build ACC_REF=bf16 ACC_PATH=prefill ACC_JSON=granite33_2b_q4nx.bf16.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy BUILD_DIR=affine-build ACC_REF=dequant ACC_PATH=decode ACC_JSON=granite33_2b_q4nx.dequant.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy BUILD_DIR=affine-build ACC_REF=dequant ACC_PATH=prefill ACC_JSON=granite33_2b_q4nx.dequant.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < granite33_2b_q4nx.bf16.decode.accuracy.json
// RUN: FileCheck %s < granite33_2b_q4nx.bf16.prefill.accuracy.json
// RUN: FileCheck %s < granite33_2b_q4nx.dequant.decode.accuracy.json
// RUN: FileCheck %s < granite33_2b_q4nx.dequant.prefill.accuracy.json
// CHECK: "kld_mean"
