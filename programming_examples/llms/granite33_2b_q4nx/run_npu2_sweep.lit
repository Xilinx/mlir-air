//
// granite33_2b_q4nx decode throughput vs context length, into
// granite33_2b_q4nx.sweep.json.
// Synthetic: the context is set by sizing the KV cache, so this measures
// latency only; run_npu2_verify_p*.lit checks correctness.
// The model takes 128k positions. 128k may not fit: whether it does depends on
// how much host memory XRT will pin for the KV BO, so it is allowed to fail.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_ibm_granite_granite_3_3_2b_instruct
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode.py --model-name granite33_2b_q4nx --makefile %S/Makefile --template-dir %S/build/sweep-decode --bench-model granite-3.3-2b --vocab-chunk-i2 10 --n-layers 40 --contexts 2048,8192,32768,131072 --expect-fail 131072 --peano-dir %PEANO_INSTALL_DIR --xrt-dir %XRT_DIR --out granite33_2b_q4nx.sweep.json
// RUN: FileCheck %s < granite33_2b_q4nx.sweep.json
// CHECK: "model": "granite33_2b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 2048
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
