//
// Qwen3.6-35B-A3B decode tok/s vs context. The context is compiled in, so
// profile-decode builds once per point.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_qwen3_6_35b_a3b_npu2
//
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode_runtime.py --model-name qwen36_35b_a3b_q4nx --makefile %S/Makefile --contexts 1024,4096,8192 --peano-dir %PEANO_INSTALL_DIR --out qwen36_35b_a3b_q4nx.sweep.json
// RUN: FileCheck %s < qwen36_35b_a3b_q4nx.sweep.json
// CHECK: "model": "qwen36_35b_a3b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 1024
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": 8192
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
