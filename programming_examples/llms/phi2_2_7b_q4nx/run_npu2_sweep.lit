//
// phi2_2_7b_q4nx decode throughput vs context length, into phi2_2_7b_q4nx.sweep.json.
// The decode is the template's layer waves and a separate BF16 head
// submission, so a step is timed on the production session (make
// profile-decode through bench/sweep_decode_runtime.py) rather than by
// bench_decode, which times the template alone. Synthetic: the KV cache is
// zeroed and the step runs at the last position, so this measures latency
// only; run_npu2_verify_p*.lit checks correctness. Only 2k: the model takes
// 2k positions.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_microsoft_phi_2
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode_runtime.py --model-name phi2_2_7b_q4nx --makefile %S/Makefile --contexts 2048 --make-var BUILD_DIR=../affine-build --peano-dir %PEANO_INSTALL_DIR --out phi2_2_7b_q4nx.sweep.json
// RUN: FileCheck %s < phi2_2_7b_q4nx.sweep.json
// CHECK: "model": "phi2_2_7b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 2048
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
