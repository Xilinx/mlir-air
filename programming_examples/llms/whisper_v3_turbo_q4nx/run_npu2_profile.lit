// SPDX-License-Identifier: MIT
//
// Whisper large-v3-turbo Q4NX profiling: compile, then time complete
// transcription requests on NPU2 (bench.py) and capture them into
// whisper_v3_turbo_q4nx.perf.json via bench/extract_perf.py. Correctness is
// gated separately by run_npu2_verify.lit.
//
// The record's `ttft_ms` is from the audio to the first token (log-mel, conv
// front end, encoder, decoder prompt), `decode_tokens_per_sec` the throughput
// after it, and `real_time_factor` the request's time over the audio's
// duration. `context_len` stays null: the encoder always sees one 30 s window.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_whisper_v3_turbo_npu2, hfweights_openai_whisper_large_v3_turbo, hfweights_hf_internal_testing_librispeech_asr_dummy
//
// RUN: mkdir -p test_npu2_profile
// RUN: cd test_npu2_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile profile | tee profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model whisper_v3_turbo_q4nx > whisper_v3_turbo_q4nx.perf.json
// RUN: FileCheck %s < whisper_v3_turbo_q4nx.perf.json
// CHECK: "model": "whisper_v3_turbo_q4nx"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "real_time_factor": {{[0-9]}}
