# Copyright (C) 2026, Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT
#
# Gemma4-E2B (text) Q4NX on NPU2 (MLIR-AIR).
#
# Both halves run on the NPU: `make prefill` gates the prefill against the CPU
# reference, `make run` generates token by token through the fused decode and
# gates the greedy continuation.
#
# TWO DECODE TEMPLATES, and they are not interchangeable. `compile-decode` builds
# the layer GATE's -- ONE decoder layer, left in the engine directory, which
# `layer-gate` scores per class against numpy. `compile-decode-full` builds the
# TOKEN driver's -- all 35 layers, left here as decode_L<N>.{xclbin,insts.bin}.
# Pointing the driver at the gate's template does not fail; it dispatches a
# 1/35-scale model.
#
# The device path is the fused_decode_ple engine (../../fused_decode_ple), a
# fork of fused_decode carrying the per-layer-embedding branch this model needs.
# Two things make Gemma4 need its own engine: PLE, and a per-layer class map
# (sliding vs full attention, own vs shared KV, 6144 vs 12288 FFN).
#
# Python deps beyond the mlir-air base environment: see requirements.txt.
#
# Quick start:
#   make compile          Build the prefill ELFs + both decode templates
#   make run              Generate on device; gated on the Paris continuation
#   make prefill          Prefill on device, gated vs the CPU reference
#   make layer-gate       Score each layer class on device against numpy
#   make check            CPU-only gate vs FLM's goldens (needs an FLM tree)

srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
PYTHON ?= $(if $(filter Windows_NT,$(OS)),python,python3)
DEC    := $(srcdir)/../../fused_decode_ple
PREFILL_DRIVER := $(srcdir)/gemma4_e2b_q4nx_prefill.py
INFER_DRIVER   := $(srcdir)/gemma4_e2b_q4nx_inference.py
BUILD_DIR := build_peano

# Padded prefill length. Every prefill ELF is built FOR this length, so changing
# it is a rebuild, not a runtime knob. Only 2048 has been run; a prefill sweep
# over other lengths is follow-up work.
CTX ?= 2048
export Q4NX_SEQ_LEN := $(CTX)

# Kernel cache, UNDER THE DIRECTORY MAKE WAS INVOKED FROM. The lit tests each
# run from their own build dir and each start with `make clean`; a cache shared
# through $(srcdir) would let one test delete the other's ELFs mid-dispatch.
export Q4NX_CACHE_DIR := $(CURDIR)/_q4nx_cache_seq$(CTX)

# Weight source: HF repo id (model.q4nx bundle) or a local dir/file. Read by the
# drivers as Q4NX_MODEL_SOURCE, exactly as in the other q4nx examples.
MODEL_SOURCE ?= FastFlowLM/Gemma4-E2B-IT-NPU2
export Q4NX_MODEL_SOURCE := $(MODEL_SOURCE)

# FLM's golden activations, for `make check` only. NOT published -- it is an
# artifact of an FLM source tree (regenerated by their gen_gemma4_ref.py), which
# is why `check` is a local development gate and `layer-gate` is the one CI runs.
FLM_REFERENCE ?=
export FLM_REFERENCE
# Full-precision checkpoint, ONLY for `make sublayer-ref`. Also local-only.
GEMMA4_FP_CHECKPOINT ?=
export GEMMA4_FP_CHECKPOINT

# ATTN_MAXL the decode template is built for. 16 is what the layer gate scores
# at (one token at position 0 attending a 16-slot cache).
LBUILD ?= 16
# The slope reference of the pair `bench_decode.exe` needs: two same-ATTN_MAXL
# builds one L apart give a per-word instruction slope, so any L can be
# dispatched from one xclbin. Only `_compile_decode_build` produces the pair.
LREF ?= $(shell expr $(LBUILD) - 1)

# Decoder layers in the swept template. The gate builds ONE wave (or two, for a
# KV-shared pair) because it scores a single layer; the sweep must build the
# whole model, or it measures a 1/35-scale dispatch and reports a number ~35x
# too good. The engine's Makefile defaults this to the gate's 1, so it has to be
# passed explicitly here rather than left to the default.
SWEEP_UNI_DEC ?= 35

# ATTN_MAXL the TOKEN driver's template is built for, i.e. the session context
# cap of `make run` / `ask` / `profile`. Separate from LBUILD, which is the layer
# gate's (16, one token attending a 16-slot cache). 128 covers the Paris gate and
# a 64-token `profile` from a short prompt with room to spare; raise it for longer
# sessions, at the cost of streaming a deeper padded cache every token.
RUN_LBUILD ?= 128

LAYERS ?= 35
# Per-layer cosine floor for the CPU gate. NOT 0.99: layer 0 inherits the int8
# embedding table's error (input_embedding cos 0.9969) and lands at 0.986, so
# 0.99 makes the gate fail on a correct tree. 0.98 still catches anything real --
# the per-layer embedding bug put layer 8 at 0.79, and a doubled embedding scale
# put layer 2 at 0.32.
TOL    ?= 0.98
# Logit-cosine floor for the on-device prefill gate (`make prefill`).
PREFILL_TOL ?= 0.99
# EMPTY by default, and that is load-bearing: an absent --prompt is what selects
# the canonical Paris prompt for `make run`. The CPU-reference targets, which
# have no Paris default of their own, fall back to REF_PROMPT.
PROMPT ?=
REF_PROMPT ?= What is the capital of France?
PROMPT_ARG := $(if $(PROMPT),--prompt "$(PROMPT)",)
N_GEN  ?= 12
# Tokens generated by `make ask` / `make profile`.
N_TOKENS ?= 64

# Layers the device gate scores. One per CLASS, which is the point: Gemma4
# crosses two attention types with two KV/FFN regimes, and a sample from one
# class says nothing about the others.
#   own kv + 6144   : 0,1,2 sliding / 4,9,14 full
#   shared kv+12288 : 15,33 sliding (kv from 13) / 19,34 full (kv from 14)
GATE_LAYERS ?= 0 4 14
GATE_PAIRS  ?= 13:15 14:19 14:34

# The shared top-k verify subsystem (verify-topk / verify-full / diagnosis).
VERIFY_RUNNER  := $(srcdir)/../verify/verify_runner.py
RUNNER_ADAPTER := gemma4_e2b_q4nx.verify_adapter
MODEL_CHOICE   ?= instruct
MAX_PROMPTS    ?= 2

.DEFAULT_GOAL := help
.PHONY: help compile compile-decode compile-decode-full \
        _compile_decode_build compile-prefill prefill run ask profile \
        profile-prefill verify verify-paris verify-topk verify-full \
        diagnosis layer-gate layer-gate-shared check gen paris sublayer-ref clean

help:
	@echo "============================================================"
	@echo " GEMMA4-E2B Q4NX on NPU2 (MLIR-AIR) -- prefill + fused decode"
	@echo "============================================================"
	@echo ""
	@echo "On device:"
	@echo "  make compile            Build everything the device path needs (prefill + decode)"
	@echo "  make compile-decode     Build the LAYER GATE's decode template (1 layer, weight-free)"
	@echo "  make compile-decode-full Build the TOKEN DRIVER's template (35 layers, weight-free)"
	@echo "  make compile-prefill    Build the prefill ELFs (weight-free)"
	@echo "  make run                Generate on NPU; gate the Paris continuation + stop"
	@echo "  make ask PROMPT=...     One Q&A turn ($(N_TOKENS) tokens)"
	@echo "  make prefill            Prefill on NPU; gate the logits vs the CPU reference"
	@echo "  make verify-paris       Alias for 'prefill' (fast weight-integrity smoke)"
	@echo "  make profile            TTFT + decode tok/s (the perf.json row)"
	@echo "  make profile-prefill    TTFT only, under the name the prefill sweep drives"
	@echo "  make verify             The full on-device LAYER gate (both halves below)"
	@echo "  make layer-gate         Score own-KV layers ($(GATE_LAYERS)) vs the numpy reference"
	@echo "  make layer-gate-shared  Score KV-SHARED layers ($(GATE_PAIRS)), two-layer builds"
	@echo "  make verify-topk        Shared top-k gate vs the bf16 HF reference (capped)"
	@echo "  make verify-full        Same, over the whole prompt file"
	@echo "  make diagnosis          Single-prompt lens through the shared runner"
	@echo ""
	@echo "On the host (no NPU, no Peano, no aie-opt):"
	@echo "  make check              Per-layer cosine vs FLM's goldens (needs FLM_REFERENCE)"
	@echo "  make gen                Greedy generation via the chat template (smoke test)"
	@echo "  make paris              One forward; PASS iff top-1 is ' Paris'"
	@echo "  make sublayer-ref       Rebuild sub-layer ground truth (needs GEMMA4_FP_CHECKPOINT)"
	@echo ""
	@echo "  make clean              Remove build artifacts and caches"
	@echo ""
	@echo "Options (override with make VAR=value):"
	@echo "  MODEL_SOURCE=<repo|dir> model.q4nx source (default $(MODEL_SOURCE))"
	@echo "  LBUILD=$(LBUILD)                ATTN_MAXL of the LAYER GATE's decode template"
	@echo "  RUN_LBUILD=$(RUN_LBUILD)         Context cap of the TOKEN DRIVER's template"
	@echo "  N_TOKENS=$(N_TOKENS)            Tokens generated by 'make ask' / 'make profile'"
	@echo "  TOL=$(TOL) LAYERS=$(LAYERS)      CPU gate floor / layer count"
	@echo "  CTX=$(CTX)               Padded prefill length (rebuilds the prefill ELFs)"
	@echo ""
	@echo "'verify' is the LAYER gate, not the siblings' top-k check -- it needs no"
	@echo "second checkpoint. The top-k check is 'verify-topk' / 'verify-full'."

## Build the decode template this example dispatches. Weight-free (weights are
## runtime BOs), so no bundle is downloaded. Delegated to the engine that owns
## the recipe rather than duplicated here.
compile-decode:
	@$(MAKE) --no-print-directory -C $(DEC) compile-decode \
	  LBUILD=$(LBUILD) PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR)

## The 22 prefill ELFs, built for CTX rows. Weight-free (weights are runtime
## BOs), so no bundle is downloaded and CI can run this without HF credentials.
compile-prefill:
	@mkdir -p $(BUILD_DIR)
	cd $(BUILD_DIR) && $(PYTHON) $(PREFILL_DRIVER) --compile-only

## The FULL-DEPTH decode template the token driver dispatches: all 35 decoder
## layers, at RUN_LBUILD. Distinct from `compile-decode`, which builds the layer
## GATE's template -- that one is a ONE-layer build left in the engine directory
## and cannot produce a token.
compile-decode-full:
	@$(MAKE) --no-print-directory -f $(srcdir)/Makefile _compile_decode_build \
	  LBUILD=$(RUN_LBUILD) PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR)

## Prefill ELFs + decode templates, the same meaning `compile` has in the other
## q4nx examples. Both decode templates: the layer gate's and the token driver's.
compile: compile-decode compile-decode-full compile-prefill

## Prefill-only correctness gate. Runs the prompt through the NPU prefill and
## scores the WHOLE logit vector against the CPU reference, not just the argmax:
## on this model a doubled embedding scale and a per-layer-embedding read from
## the wrong tensor both still predicted ' Paris'.
prefill:
	@mkdir -p $(BUILD_DIR)
	cd $(BUILD_DIR) && $(PYTHON) $(PREFILL_DRIVER) --gate --tol $(PREFILL_TOL)

## NPU prefill + fused NPU decode. With no PROMPT this is the canonical Paris
## gate: the first token must be 9079 (" Paris") and the continuation must match
## the recorded greedy run, which is the half a first-token check cannot see.
run:
	@cd $(srcdir) && $(PYTHON) $(INFER_DRIVER) --gate --n-tokens 9 $(PROMPT_ARG)

## Single Q&A turn:  make ask PROMPT="What is the capital of France?"
ask:
	@cd $(srcdir) && $(PYTHON) $(INFER_DRIVER) \
		--n-tokens $(N_TOKENS) $(PROMPT_ARG)

## Fast weight-integrity smoke: prefill only, gated on the logit cosine. Cheap --
## no decode template needed.
verify-paris: prefill

## The perf.json row the nightly LLM benchmark collects, under the name every
## other q4nx example uses: TTFT + decode tok/s, end to end over N_TOKENS tokens.
##
## --ignore-eos, unlike the siblings: this model answers the Paris prompt in two
## tokens and stops, so a run that honours EOS reports a tok/s dominated by
## per-call setup instead of by decode. Latency only -- the text past the stop is
## not meaningful, and `make run` is what gates the text.
profile:
	@cd $(srcdir) && $(PYTHON) $(INFER_DRIVER) --ignore-eos \
		--n-tokens $(N_TOKENS) $(PROMPT_ARG)

## Warm prefill TTFT at CTX. Prints the TTFT / [bench] lines bench/sweep_prefill.py
## and bench/extract_perf.py parse; latency only, never a correctness gate.
profile-prefill:
	@mkdir -p $(BUILD_DIR)
	cd $(BUILD_DIR) && Q4NX_BENCH_L=$(CTX) $(PYTHON) $(PREFILL_DRIVER)

## The full-depth template PAIR the decode sweep dispatches, left in this
## directory as decode_L<N>.{xclbin,insts.bin}. Named with a leading underscore
## and shaped exactly like the other q4nx examples' because bench/sweep_decode.py
## invokes it by that name and then looks for those files.
##
## Deliberately NOT idempotent, for the same reason the engine's compile-decode
## is not: the sweep rebuilds at a new ATTN_MAXL for every context, and a
## skipped rebuild benches the previous context's binary and reports its number
## under the new context's label. sweep_decode.py also md5s the result and
## rejects a repeat, which is the backstop for exactly this.
_compile_decode_build:
	@set -e; for L in $(LBUILD) $(LREF); do \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$$L \
	    UNI_DEC=$(SWEEP_UNI_DEC) PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR); \
	  mv -f $(DEC)/decode.xclbin    $(srcdir)/decode_L$$L.xclbin; \
	  mv -f $(DEC)/decode.insts.bin $(srcdir)/decode_L$$L.insts.bin; \
	done
	@echo "Gemma4 decode templates built: decode_L$(LBUILD) + decode_L$(LREF) (UNI_DEC=$(SWEEP_UNI_DEC))."

## One dispatch is not a verdict on this hardware. A few percent of NPU2
## dispatches hit the firmware TDR watchdog; the dispatch then COMPLETES but
## returns an untrustworthy answer, so validate_layer_npu.py refuses to score it
## and exits 2. That is "no signal, re-run" -- not "the layer is wrong" -- and
## the taint is not cleared inside the process (a fresh hw_context does not help
## either), so the retry has to be a NEW process. Seen once in a full nightly.
##
## THE EXIT CODES ARE LOAD-BEARING: 0 pass, 2 inconclusive -> re-score, 1 FAIL ->
## stop at once. Retrying a 1 would mask a real numeric regression, which is the
## entire thing this gate exists to catch. A layer still inconclusive after
## SCORE_ATTEMPTS also fails: we got no signal, so we cannot claim it works.
##
## Reads its arguments from $$SCORE_ARGS rather than taking them as a $$(call)
## parameter, because one call site passes `--layers 13,15` and $$(call) splits
## its arguments on commas.
SCORE_ATTEMPTS ?= 3
define score_layer
  n=0; while :; do \
    n=$$((n+1)); \
    $(PYTHON) validate_layer_npu.py $$SCORE_ARGS && break; rc=$$?; \
    if [ $$rc -ne 2 ]; then exit $$rc; fi; \
    if [ $$n -ge $(SCORE_ATTEMPTS) ]; then \
      echo "FAIL: still INCONCLUSIVE after $(SCORE_ATTEMPTS) attempts; the NPU2 TDR did not clear, so this run scored nothing"; \
      exit 1; \
    fi; \
    echo "  (inconclusive: an NPU2 TDR, not a numeric failure -- re-scoring in a fresh process, attempt $$((n+1)) of $(SCORE_ATTEMPTS))"; \
  done
endef

## Score the OWN-KV layers on device against the numpy reference, one per class.
##
## Rebuilds the template before each run. That is not defensive: validate_layer_npu.py
## does NOT build -- it dispatches whatever decode.xclbin is on disk -- so a run
## against a leftover template from a different UNI_DEC scores a different design
## and reads as a numerics regression.
layer-gate:
	@set -e; for L in $(GATE_LAYERS); do \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=1 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir); \
	  SCORE_ARGS="--layer $$L --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$$L.npz"; \
	  $(score_layer); \
	done

## Score the KV-SHARED layers (>=15). Each needs a TWO-layer build: the layer
## that owns the cache runs in slab 0, the shared layer in slab 1 reading it
## (DECODE_KV_SRC=0,0). The reference chain is started from the device's own
## slab-0 output (--prefix-dump), because scoring a chain end-to-end measures
## the composition of both layers' errors rather than the shared layer's.
layer-gate-shared:
	@set -e; for P in $(GATE_PAIRS); do \
	  SRC=$${P%:*}; L=$${P#*:}; \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=1 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir); \
	  SCORE_ARGS="--layer $$SRC --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$$SRC.npz --dump /tmp/g4_d$$SRC.npz"; \
	  $(score_layer); \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=2 KV_SRC=0,0 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir); \
	  SCORE_ARGS="--layers $$SRC,$$L --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$${SRC}_$$L.npz --prefix-dump /tmp/g4_d$$SRC.npz"; \
	  $(score_layer); \
	done

## The on-device correctness gate, under the name the other q4nx examples use.
## Theirs is a top-k token-set check over a generated sequence and needs a
## prefill engine; this one scores the decoder layer itself, per class. Both
## halves, because either alone leaves three of the six classes unscored.
verify: layer-gate layer-gate-shared

## The shared top-k token-set inclusion gate (NPU q4nx vs HF bf16), through the
## same verify/ subsystem as the other q4nx examples. Capped at MAX_PROMPTS;
## `verify-full` is the whole prompt file.
##
## NOT wired into `verify`, and that is deliberate: `verify` is the target CI
## runs, the layer gate needs no second checkpoint, and this one downloads a bf16
## Gemma4-E2B. Two gates over different things, neither subsuming the other.
verify-topk:
	cd $(srcdir)/.. && $(PYTHON) $(VERIFY_RUNNER) --runner=$(RUNNER_ADAPTER) \
		--prompts topk_token --model $(MODEL_CHOICE) --max-prompts $(MAX_PROMPTS)

## Full-sweep variant of `verify-topk` (all prompts in the prompt file).
verify-full:
	cd $(srcdir)/.. && $(PYTHON) $(VERIFY_RUNNER) --runner=$(RUNNER_ADAPTER) \
		--prompts topk_token --model $(MODEL_CHOICE)

## Diagnosis lens (single prompt through the shared runner, informational).
## The Q4NX prefill does not expose per-layer ffn_out and the decode runs all 35
## layers in one dispatch, so this reports the token-level view, not per-layer
## cosines.
diagnosis:
	cd $(srcdir)/.. && $(PYTHON) $(VERIFY_RUNNER) --runner=$(RUNNER_ADAPTER) \
		--prompts single --prompt "$(if $(PROMPT),$(PROMPT),$(REF_PROMPT))" \
		--model $(MODEL_CHOICE)

## CPU-only per-layer gate against FLM's own golden activations. ~4 min, no NPU.
## Needs an FLM source tree (FLM_REFERENCE); `layer-gate` is the gate that does not.
check:
	cd $(srcdir) && $(PYTHON) check_vs_flm_reference.py \
		--bundle $(MODEL_SOURCE) --layers $(LAYERS) --tol $(TOL)

## Greedy generation through the chat template. Smoke test, NOT a gate.
## Slow by construction: no KV reuse across tokens, so each token re-runs the
## whole prompt (~35 s/token at 16 tokens of context).
gen:
	cd $(srcdir) && $(PYTHON) run_reference.py --bundle $(MODEL_SOURCE) gen \
		--prompt "$(if $(PROMPT),$(PROMPT),$(REF_PROMPT))" --n-tokens $(N_GEN)

## Fast smoke test: one forward, expect ' Paris' as top-1.
paris:
	cd $(srcdir) && $(PYTHON) run_reference.py --bundle $(MODEL_SOURCE) paris

## Regenerate sub-layer ground truth from the full-precision checkpoint.
## Only needed when bisecting INSIDE a layer -- FLM's shipped reference has one
## tensor per layer, which cannot tell attention from FFN from the PLE tail.
## Loads a 10.2 GB checkpoint in float32; needs ~25 GB RAM and a few minutes.
sublayer-ref:
	cd $(srcdir) && $(PYTHON) dump_sublayer_reference.py \
		--layers 7,8,9 --out sublayer_ref.npz

## Remove build artifacts and caches, here and in the decode engine this example
## drives -- the engine's kernels are compiled with -DMODEL_TYPE=GEMMA4_E2B, and
## leaving them there makes a later build of another model link Gemma4 objects.
clean:
	@$(MAKE) --no-print-directory -C $(DEC) clean
	rm -rf $(srcdir)/__pycache__ $(srcdir)/build_peano $(srcdir)/build_chess 2>/dev/null || true
	rm -f $(srcdir)/*.npz $(srcdir)/decode_L*.xclbin $(srcdir)/decode_L*.insts.bin 2>/dev/null || true
	rm -rf $(srcdir)/_q4nx_cache_seq* $(CURDIR)/_q4nx_cache_seq* $(srcdir)/build_peano 2>/dev/null || true
	@echo "Gemma4 caches and the PLE decode build removed."
