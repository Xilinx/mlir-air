#
# Gemma4-E2B (text) Q4NX on NPU2 (MLIR-AIR).
#
# THIS EXAMPLE IS PARTIAL, and the target list says which half is which. The
# decoder layer runs on the NPU and is gated there per layer (`make layer-gate`,
# `make compile-decode`); there is no prefill engine and no token-level chatbot
# yet, so the `run` / `ask` / `verify` / `profile` targets the other llms/
# examples carry are deliberately absent rather than present and broken.
#
# The device path is the fused_decode_ple engine (../../fused_decode_ple), a
# fork of fused_decode carrying the per-layer-embedding branch this model needs.
# Two things make Gemma4 need its own engine: PLE, and a per-layer class map
# (sliding vs full attention, own vs shared KV, 6144 vs 12288 FFN).
#
# Python deps beyond the mlir-air base environment: see requirements.txt.
#
# Quick start:
#   make compile-decode   Build the decode template (weight-free)
#   make layer-gate       Score each layer class on device against numpy
#   make check            CPU-only gate vs FLM's goldens (needs an FLM tree)

srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
PYTHON ?= $(if $(filter Windows_NT,$(OS)),python,python3)
DEC    := $(srcdir)/../../fused_decode_ple

# Weight source: HF repo id (model.q4nx bundle) or a local dir/file. Read by the
# drivers as Q4NX_MODEL_SOURCE, exactly as in the other q4nx examples.
MODEL_SOURCE ?= FastFlowLM/Gemma4-E2B-IT-NPU2
export Q4NX_MODEL_SOURCE := $(MODEL_SOURCE)

# FLM's golden activations, for `make check` only. NOT published -- it is an
# artifact of an FLM source tree (regenerated by their gen_gemma4_ref.py), which
# is why `check` is a local development gate and `layer-gate` is the one CI runs.
FLM_REFERENCE ?=
export FLM_REFERENCE
# Full-precision checkpoint, ONLY for `make sublayer-ref`. Also local-only.
GEMMA4_FP_CHECKPOINT ?=
export GEMMA4_FP_CHECKPOINT

# ATTN_MAXL the decode template is built for. 16 is what the layer gate scores
# at (one token at position 0 attending a 16-slot cache).
LBUILD ?= 16

LAYERS ?= 35
# Per-layer cosine floor for the CPU gate. NOT 0.99: layer 0 inherits the int8
# embedding table's error (input_embedding cos 0.9969) and lands at 0.986, so
# 0.99 makes the gate fail on a correct tree. 0.98 still catches anything real --
# the per-layer embedding bug put layer 8 at 0.79, and a doubled embedding scale
# put layer 2 at 0.32.
TOL    ?= 0.98
PROMPT ?= What is the capital of France?
N_GEN  ?= 12

# Layers the device gate scores. One per CLASS, which is the point: Gemma4
# crosses two attention types with two KV/FFN regimes, and a sample from one
# class says nothing about the others.
#   own kv + 6144   : 0,1,2 sliding / 4,9,14 full
#   shared kv+12288 : 15,33 sliding (kv from 13) / 19,34 full (kv from 14)
GATE_LAYERS ?= 0 4 14
GATE_PAIRS  ?= 13:15 14:19 14:34

.DEFAULT_GOAL := help
.PHONY: help compile-decode layer-gate layer-gate-shared check gen paris sublayer-ref clean

help:
	@echo "============================================================"
	@echo " GEMMA4-E2B Q4NX on NPU2 (MLIR-AIR) -- decoder layer only"
	@echo "============================================================"
	@echo ""
	@echo "On device:"
	@echo "  make compile-decode     Build the decode template (weight-free)"
	@echo "  make layer-gate         Score own-KV layers ($(GATE_LAYERS)) vs the numpy reference"
	@echo "  make layer-gate-shared  Score KV-SHARED layers ($(GATE_PAIRS)), two-layer builds"
	@echo ""
	@echo "On the host (no NPU, no Peano, no aie-opt):"
	@echo "  make check              Per-layer cosine vs FLM's goldens (needs FLM_REFERENCE)"
	@echo "  make gen                Greedy generation via the chat template (smoke test)"
	@echo "  make paris              One forward; PASS iff top-1 is ' Paris'"
	@echo "  make sublayer-ref       Rebuild sub-layer ground truth (needs GEMMA4_FP_CHECKPOINT)"
	@echo ""
	@echo "  make clean              Remove build artifacts and caches"
	@echo ""
	@echo "Options (override with make VAR=value):"
	@echo "  MODEL_SOURCE=<repo|dir> model.q4nx source (default $(MODEL_SOURCE))"
	@echo "  LBUILD=$(LBUILD)                ATTN_MAXL the decode template is built for"
	@echo "  TOL=$(TOL) LAYERS=$(LAYERS)      CPU gate floor / layer count"
	@echo ""
	@echo "NOT here yet: prefill, token-level generation on device, top-k verify."

## Build the decode template this example dispatches. Weight-free (weights are
## runtime BOs), so no bundle is downloaded. Delegated to the engine that owns
## the recipe rather than duplicated here.
compile-decode:
	@$(MAKE) --no-print-directory -C $(DEC) compile-decode \
	  LBUILD=$(LBUILD) PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR)

## Score the OWN-KV layers on device against the numpy reference, one per class.
##
## Rebuilds the template before each run. That is not defensive: validate_layer_npu.py
## does NOT build -- it dispatches whatever decode.xclbin is on disk -- so a run
## against a leftover template from a different UNI_DEC scores a different design
## and reads as a numerics regression.
layer-gate:
	@set -e; for L in $(GATE_LAYERS); do \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=1 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir) && $(PYTHON) validate_layer_npu.py --layer $$L \
	    --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$$L.npz; \
	done

## Score the KV-SHARED layers (>=15). Each needs a TWO-layer build: the layer
## that owns the cache runs in slab 0, the shared layer in slab 1 reading it
## (DECODE_KV_SRC=0,0). The reference chain is started from the device's own
## slab-0 output (--prefix-dump), because scoring a chain end-to-end measures
## the composition of both layers' errors rather than the shared layer's.
layer-gate-shared:
	@set -e; for P in $(GATE_PAIRS); do \
	  SRC=$${P%:*}; L=$${P#*:}; \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=1 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir) && $(PYTHON) validate_layer_npu.py --layer $$SRC \
	    --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$$SRC.npz \
	    --dump /tmp/g4_d$$SRC.npz; \
	  $(MAKE) --no-print-directory -C $(DEC) compile-decode LBUILD=$(LBUILD) \
	    UNI_DEC=2 KV_SRC=0,0 PEANO_INSTALL_DIR=$(PEANO_INSTALL_DIR) >/dev/null; \
	  cd $(srcdir) && $(PYTHON) validate_layer_npu.py --layers $$SRC,$$L \
	    --attn-maxl $(LBUILD) --rebuild-cache --cache /tmp/g4_L$${SRC}_$$L.npz \
	    --prefix-dump /tmp/g4_d$$SRC.npz; \
	done

## CPU-only per-layer gate against FLM's own golden activations. ~4 min, no NPU.
## Needs an FLM source tree (FLM_REFERENCE); `layer-gate` is the gate that does not.
check:
	cd $(srcdir) && $(PYTHON) check_vs_flm_reference.py \
		--bundle $(MODEL_SOURCE) --layers $(LAYERS) --tol $(TOL)

## Greedy generation through the chat template. Smoke test, NOT a gate.
## Slow by construction: no KV reuse across tokens, so each token re-runs the
## whole prompt (~35 s/token at 16 tokens of context).
gen:
	cd $(srcdir) && $(PYTHON) run_reference.py --bundle $(MODEL_SOURCE) gen \
		--prompt "$(PROMPT)" --n-tokens $(N_GEN)

## Fast smoke test: one forward, expect ' Paris' as top-1.
paris:
	cd $(srcdir) && $(PYTHON) run_reference.py --bundle $(MODEL_SOURCE) paris

## Regenerate sub-layer ground truth from the full-precision checkpoint.
## Only needed when bisecting INSIDE a layer -- FLM's shipped reference has one
## tensor per layer, which cannot tell attention from FFN from the PLE tail.
## Loads a 10.2 GB checkpoint in float32; needs ~25 GB RAM and a few minutes.
sublayer-ref:
	cd $(srcdir) && $(PYTHON) dump_sublayer_reference.py \
		--layers 7,8,9 --out sublayer_ref.npz

## Remove build artifacts and caches, here and in the decode engine this example
## drives -- the engine's kernels are compiled with -DMODEL_TYPE=GEMMA4_E2B, and
## leaving them there makes a later build of another model link Gemma4 objects.
clean:
	@$(MAKE) --no-print-directory -C $(DEC) clean
	rm -rf $(srcdir)/__pycache__ $(srcdir)/build_peano $(srcdir)/build_chess 2>/dev/null || true
	rm -f $(srcdir)/*.npz 2>/dev/null || true
	@echo "Gemma4 caches and the PLE decode build removed."
