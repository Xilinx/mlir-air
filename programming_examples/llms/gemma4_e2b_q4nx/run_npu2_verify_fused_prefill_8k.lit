//
// GEMMA4-E2B fused prefill on an 8000-token prompt: 63 chunks, far past the
// sliding layers' 512-token window, gated against the CPU reference by
// whole-logit cosine and first token. Built as the prefill sweep builds it
// (FUSED_MAX_LEN=32768), so the build whose times are published is the one
// gated here. run_npu2_verify_fused_prefill.lit gates the default build on
// one and three chunks.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_gemma4_e2b_it_npu2
//
// RUN: mkdir -p test_npu2_verify_fused_prefill_8k
// RUN: cd test_npu2_verify_fused_prefill_8k
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-fused-prefill FUSED_MAX_LEN=32768 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile fused-prefill-8k PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
//
// CHECK: prompt 8000 tokens (63 chunk(s))
// CHECK: logit cosine vs CPU reference = {{[01]\.[0-9]+}}
// CHECK: GATE PASS
