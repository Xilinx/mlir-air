//
// Gemma4-E2B fused prefill (fused_prefill/): build it, then gate one chunk and
// a three-chunk prompt against the CPU reference by whole-logit cosine and
// first token. The build itself fails if the op builds disagree on the device
// configuration they all share.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_gemma4_e2b_it_npu2
//
// RUN: mkdir -p test_npu2_verify_fused_prefill
// RUN: cd test_npu2_verify_fused_prefill
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=SHORT
// RUN: make -f %S/Makefile fused-prefill-long PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=LONG
//
// SHORT: prompt {{[0-9]+}} tokens (1 chunk(s))
// SHORT: logit cosine vs CPU reference = 0.{{[0-9]+}}
// SHORT: GATE PASS
// LONG: prompt {{[0-9]+}} tokens (3 chunk(s))
// LONG: logit cosine vs CPU reference = 0.{{[0-9]+}}
// LONG: GATE PASS
