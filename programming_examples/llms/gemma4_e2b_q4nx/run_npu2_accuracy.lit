//
// gemma4_e2b_q4nx accuracy: teacher-forced PPL + KL divergence of the NPU decode
// and prefill paths against the bf16 HF checkpoint (unsloth/gemma-4-E2B-it)
// on wikitext-2 (verify/accuracy.py). Informational: this checks only that the
// measurement ran; run_npu2_verify.lit is the gate. The 2048-token chunks need
// the fused prefill and a decode built for 2048 tokens.
// Collected by check-programming-examples-llms-accuracy.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hf_token, hfweights_fastflowlm_gemma4_e2b_it_npu2, hfweights_unsloth_gemma_4_e2b_it, hfweights_ggml_org_ci
//
// RUN: mkdir -p test_npu2_accuracy
// RUN: cd test_npu2_accuracy
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile-decode-elf RUN_LBUILD=2048 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=bf16 ACC_PATH=decode ACC_JSON=gemma4_e2b_q4nx.bf16.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=bf16 ACC_PATH=prefill ACC_JSON=gemma4_e2b_q4nx.bf16.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < gemma4_e2b_q4nx.bf16.decode.accuracy.json
// RUN: FileCheck %s < gemma4_e2b_q4nx.bf16.prefill.accuracy.json
// CHECK: "kld_mean"
