//
// gemma4_e2b_q4nx task scores: GSM8K and MMLU (lm-evaluation-harness) on the NPU
// and on the bf16 HF checkpoint (unsloth/gemma-4-E2B-it), paired per item
// (verify/lm_eval_npu.py). Informational: this checks only that the comparison
// ran; run_npu2_verify.lit is the gate. The 2048-token sequences need the fused
// prefill and a decode built for 2048 tokens.
// Collected by check-programming-examples-llms-tasks.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hf_token, hfweights_fastflowlm_gemma4_e2b_it_npu2, hfweights_unsloth_gemma_4_e2b_it, hfweights_openai_gsm8k, hfweights_cais_mmlu
//
// RUN: mkdir -p test_npu2_tasks
// RUN: cd test_npu2_tasks
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile-decode-elf RUN_LBUILD=2048 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks TASKS=gsm8k TASKS_LIMIT=100 TASKS_JSON=gemma4_e2b_q4nx.gsm8k.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks TASKS=mmlu TASKS_LIMIT=10 TASKS_JSON=gemma4_e2b_q4nx.mmlu.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < gemma4_e2b_q4nx.gsm8k.tasks.json
// RUN: FileCheck %s < gemma4_e2b_q4nx.mmlu.tasks.json
// CHECK: "mcnemar_p"
