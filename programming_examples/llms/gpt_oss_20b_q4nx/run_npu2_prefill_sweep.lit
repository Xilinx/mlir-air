//
// GPT-OSS-20B TTFT vs prompt length: the prompt prefilled, then the first
// token from a decode step.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_gpt_oss_20b_npu2
//
// RUN: mkdir -p test_peano_prefill_sweep
// RUN: cd test_peano_prefill_sweep
// RUN: %PYTHON %S/../bench/sweep_prefill.py --model-name gpt_oss_20b_q4nx --makefile %S/Makefile --lengths 128,512,2048 --peano-dir %PEANO_INSTALL_DIR --out gpt_oss_20b_q4nx.prefill_sweep.json
// RUN: FileCheck %s < gpt_oss_20b_q4nx.prefill_sweep.json
// CHECK: "model": "gpt_oss_20b_q4nx"
// CHECK: "axis": "prefill_len"
// CHECK: "prefill_len": 128
// CHECK-NEXT: "ttft_ms": {{[0-9]}}
