//
// GPT-OSS-20B decode tok/s vs context. The context is compiled in, so
// profile-decode builds once per point.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_gpt_oss_20b_npu2
//
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode_runtime.py --model-name gpt_oss_20b_q4nx --makefile %S/Makefile --contexts 1024,4096,8192,32768,65536 --peano-dir %PEANO_INSTALL_DIR --out gpt_oss_20b_q4nx.sweep.json
// RUN: FileCheck %s < gpt_oss_20b_q4nx.sweep.json
// CHECK: "model": "gpt_oss_20b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 1024
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
