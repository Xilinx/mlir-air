//
// GPT-OSS-20B TTFT and decode throughput, captured into
// gpt_oss_20b_q4nx.perf.json by bench/extract_perf.py. There is no prefill:
// TTFT is the prompt going through the decode loop.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_gpt_oss_20b_npu2
//
// RUN: mkdir -p test_peano_profile
// RUN: cd test_peano_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile profile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR N_TOKENS=128 PROMPT="What is the capital of France?" | tee profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model gpt_oss_20b_q4nx --n-tokens 128 --prompt "What is the capital of France?" > gpt_oss_20b_q4nx.perf.json
// RUN: FileCheck %s < gpt_oss_20b_q4nx.perf.json
// CHECK: "model": "gpt_oss_20b_q4nx"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
