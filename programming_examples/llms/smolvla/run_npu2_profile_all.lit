//
// SmolVLA profiling on the experimental all-NPU path: `make profile-all` times
// pure CPU, NPU vision, and every stage on the NPU, interleaved in one process.
// The machine-readable "Action chunk" line then carries the all-NPU arm, which
// is recorded as its own model, smolvla_all, so the vision-only smolvla series
// from run_npu2_profile.lit keeps its meaning. Correctness is gated separately
// by run_npu2_verify_all.lit.
//
// run_npu2_profile.lit cleans the example, expert ELFs included, so this builds
// them again.
//
// REQUIRES: ryzen_ai_npu2, peano, lerobot, hfweights_lerobot_smolvla_base, hfweights_huggingfacetb_smolvlm2_500m_video_instruct
//
// RUN: mkdir -p test_peano_profile_all
// RUN: cd test_peano_profile_all
// RUN: make -f %S/Makefile compile-expert PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile profile-all PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | tee profile.txt
// RUN: FileCheck --check-prefix=ARM %s < profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model smolvla_all > smolvla_all.perf.json
// RUN: FileCheck %s < smolvla_all.perf.json
// The extractor takes any "Action chunk (...)" line, so check that it is the
// all-NPU arm's before recording it as smolvla_all.
// ARM: Action chunk (NPU all):
//
// CHECK: "model": "smolvla_all"
// CHECK: "ttft_ms": {{[0-9]}}
