//
// LLAMA-3.2-1B Q4NX prefill profiling: compile then run the warm TTFT benchmark
// at CTX, printing the WALL / NPU-dispatch / host breakdown. Perf is best-effort;
// this test gates only that profiling ran end to end (and the Paris gate still
// passes). Needs the external weight data, so gated on `q4nx_weights`.
//
// REQUIRES: ryzen_ai_npu2, peano, q4nx_weights
//
// RUN: mkdir -p test_npu2_profile
// RUN: cd test_npu2_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile profile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR CTX=2048 | tee profile.txt
// RUN: FileCheck %s < profile.txt
// CHECK: *** PARIS ***
// CHECK: [bench] L=2048: WALL=
