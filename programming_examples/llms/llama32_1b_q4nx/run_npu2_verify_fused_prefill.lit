//
// llama32_1b_q4nx fused prefill (shared/fused_prefill): build it, then gate one
// chunk and a three-chunk prompt against the fp32 reference by logit cosine and
// first token, then an 8k-token prompt, where every attention path runs well
// past the short prompts.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_llama_3_2_1b_npu2
//
// RUN: mkdir -p test_npu2_verify_fused_prefill
// RUN: cd test_npu2_verify_fused_prefill
// RUN: make -f %S/Makefile compile-fused-prefill FUSED_MAX_LEN=8192 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=SHORT
// RUN: make -f %S/Makefile fused-prefill-long PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=LONG
// RUN: make -f %S/Makefile fused-prefill-8k PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=LONG8K
//
// SHORT: prompt {{[0-9]+}} tokens (1 chunk(s))
// SHORT: GATE PASS
// LONG: prompt {{[0-9]+}} tokens (3 chunk(s))
// LONG: GATE PASS
// LONG8K: prompt {{[0-9]+}} tokens ({{[0-9]+}} chunk(s))
// LONG8K: GATE PASS
