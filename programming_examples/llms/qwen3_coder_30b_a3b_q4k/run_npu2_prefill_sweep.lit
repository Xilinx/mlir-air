//
// Qwen3-Coder-30B-A3B TTFT vs prompt length: the prompt prefilled on the fused
// prefill device, then the first token from the LM head.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_qwen_qwen3_coder_30b_a3b_instruct
//
// RUN: mkdir -p test_peano_prefill_sweep
// RUN: cd test_peano_prefill_sweep
// RUN: %PYTHON %S/../bench/sweep_prefill.py --model-name qwen3_coder_30b_a3b_q4k --makefile %S/Makefile --lengths 128,512,2048 --peano-dir %PEANO_INSTALL_DIR --out qwen3_coder_30b_a3b_q4k.prefill_sweep.json
// RUN: FileCheck %s < qwen3_coder_30b_a3b_q4k.prefill_sweep.json
// CHECK: "model": "qwen3_coder_30b_a3b_q4k"
// CHECK: "axis": "prefill_len"
// CHECK: "prefill_len": 128
// CHECK-NEXT: "ttft_ms": {{[0-9]}}
