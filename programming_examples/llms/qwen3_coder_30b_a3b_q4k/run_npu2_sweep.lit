//
// Qwen3-Coder-30B-A3B decode tok/s vs context. The context is compiled in, so
// profile-decode builds once per point.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_qwen_qwen3_coder_30b_a3b_instruct
//
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode_runtime.py --model-name qwen3_coder_30b_a3b_q4k --makefile %S/Makefile --contexts 1024,4096 --peano-dir %PEANO_INSTALL_DIR --out qwen3_coder_30b_a3b_q4k.sweep.json
// RUN: FileCheck %s < qwen3_coder_30b_a3b_q4k.sweep.json
// CHECK: "model": "qwen3_coder_30b_a3b_q4k"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 1024
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
