//
// llama31_8b_q4nx accuracy at depth: the decode built for 8192 tokens of context,
// a wikitext-2 chunk of 8192 reached through the NPU prefill and then the
// decode's own KV cache, and its last 256 positions scored against the same
// weights dequantized on the CPU (verify/accuracy.py --ctx --score). Deeper
// contexts work the same way by hand: `make compile-decode LBUILD=<n>`, then
// `make accuracy ACC_EXTRA="--ctx <n> --score 256" ACC_CHUNKS=1`.
// Collected by check-programming-examples-llms-accuracy.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hf_token, hfweights_nousresearch_meta_llama_3_1_8b_instruct, hfweights_fastflowlm_llama_3_1_8b_npu2, hfweights_ggml_org_ci
//
// RUN: mkdir -p test_peano_accuracy_depth
// RUN: cd test_peano_accuracy_depth
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-decode LBUILD=8192 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=dequant ACC_PATH=decode ACC_CHUNKS=1 ACC_EXTRA="--ctx 8192 --score 256" ACC_JSON=llama31_8b_q4nx.dequant.decode.c8192.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < llama31_8b_q4nx.dequant.decode.c8192.accuracy.json
// CHECK: "kld_mean"
