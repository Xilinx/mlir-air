//
// qwen35_0_8b_q4nx accuracy: teacher-forced PPL + KL divergence of the NPU
// decode and prefill paths against HF BF16 Qwen/Qwen3.5-0.8B at its pinned
// revision on wikitext-2 (verify/accuracy.py). Informational: this checks only
// that the measurement ran; run_npu2_verify.lit is the gate. The 2048-token
// chunks need the decode of capacity 2048.
// Collected by check-programming-examples-llms-accuracy.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, llvm_link_pre23, hf_token, hfweights_fastflowlm_qwen3_5_0_8b_npu2, hfweights_qwen_qwen3_5_0_8b, hfweights_ggml_org_ci
//
// RUN: mkdir -p test_npu2_accuracy
// RUN: cd test_npu2_accuracy
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile CAPACITIES=2048 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy C=2048 ACC_REF=bf16 ACC_PATH=decode ACC_JSON=qwen35_0_8b_q4nx.bf16.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy C=2048 ACC_REF=bf16 ACC_PATH=prefill ACC_JSON=qwen35_0_8b_q4nx.bf16.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < qwen35_0_8b_q4nx.bf16.decode.accuracy.json
// RUN: FileCheck %s < qwen35_0_8b_q4nx.bf16.prefill.accuracy.json
// CHECK: "kld_mean"
