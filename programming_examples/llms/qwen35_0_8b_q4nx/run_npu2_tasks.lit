//
// qwen35_0_8b_q4nx task scores: GSM8K and MMLU (lm-evaluation-harness) on the
// NPU and on HF BF16 Qwen/Qwen3.5-0.8B at its pinned revision, paired per item
// (verify/lm_eval_npu.py). Informational: this checks only that the
// comparison ran; run_npu2_verify.lit is the gate. The 2048-token sequences
// need the decode of capacity 2048.
// Collected by check-programming-examples-llms-tasks.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, llvm_link_pre23, hf_token, hfweights_fastflowlm_qwen3_5_0_8b_npu2, hfweights_qwen_qwen3_5_0_8b, hfweights_openai_gsm8k, hfweights_cais_mmlu
//
// RUN: mkdir -p test_npu2_tasks
// RUN: cd test_npu2_tasks
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile CAPACITIES=2048 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks C=2048 TASKS=gsm8k TASKS_LIMIT=100 TASKS_JSON=qwen35_0_8b_q4nx.gsm8k.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks C=2048 TASKS=mmlu TASKS_LIMIT=10 TASKS_JSON=qwen35_0_8b_q4nx.mmlu.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < qwen35_0_8b_q4nx.gsm8k.tasks.json
// RUN: FileCheck %s < qwen35_0_8b_q4nx.mmlu.tasks.json
// CHECK: "mcnemar_p"
