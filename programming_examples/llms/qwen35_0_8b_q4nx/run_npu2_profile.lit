//
// Qwen3.5-0.8B Q4NX profiling: build the prefill device and the decode of
// capacity 1024, then one warm-up request and a timed one of N_TOKENS tokens,
// TTFT and decode throughput into qwen35_0_8b_q4nx.perf.json via
// bench/extract_perf.py (collected by the nightly LLM benchmark). Perf is
// best-effort; this test gates only that profiling ran end to end. The
// model's own complete-request timing at its four configurations is
// `make bench-all` (README.md).
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, llvm_link_pre23, hf_token, hfweights_fastflowlm_qwen3_5_0_8b_npu2, hfweights_qwen_qwen3_5_0_8b
//
// RUN: mkdir -p test_npu2_profile
// RUN: cd test_npu2_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile CAPACITIES=1024 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: %run_on_npu2% make -f %S/Makefile profile C=1024 N_TOKENS=64 PROMPT="What is the capital of France?" PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | tee profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model qwen35_0_8b_q4nx --n-tokens 64 > qwen35_0_8b_q4nx.perf.json
// RUN: FileCheck %s < qwen35_0_8b_q4nx.perf.json
// CHECK: "model": "qwen35_0_8b_q4nx"
// A parsed number, not just a well-formed file: if the driver's print format
// drifts out of extract_perf.py's regexes the metric goes null and the
// published benchmark row silently blanks while the test stays green.
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
