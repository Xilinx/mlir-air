// RUN: make -f %S/Makefile tasks TASKS=mmlu TASKS_LIMIT=10 TASKS_JSON=qwen3_4b_q4nx.mmlu.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
