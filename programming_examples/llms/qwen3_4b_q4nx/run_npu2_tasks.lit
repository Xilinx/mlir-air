// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hf_token, hfweights_fastflowlm_qwen3_4b_npu2, hfweights_qwen_qwen3_4b, hfweights_openai_gsm8k, hfweights_cais_mmlu
