// PERF_MODEL: qwen3_4b_dflash_b8
// Fixed GPU-explanation prompt, cap256, EOS on, greedy/thinking off. Warm NPU
// prefill + the production complete decode loop; Full80 is a separate series.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_qwen3_4b_npu2, hfweights_qwen_qwen3_4b, hfweights_z_lab_qwen3_4b_dflash_b16
// RUN: make -f %S/Makefile weights compile BUILD_DIR=dflash-build OFFLINE=1
// RUN: make -f %S/Makefile profile BUILD_DIR=dflash-build PROFILE_OUTPUT=qwen3_4b_dflash_b8.perf.json | tee profile.txt
// RUN: FileCheck %s < qwen3_4b_dflash_b8.perf.json
// CHECK: "model": "qwen3_4b_dflash_b8"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
