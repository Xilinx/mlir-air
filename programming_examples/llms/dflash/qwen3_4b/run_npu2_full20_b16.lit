// Nightly pair: first four saved cases per dataset, one pass per engine,
// cap2048/EOS on. Uses the same persistent inputs and timing as Full80.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_qwen3_4b_npu2, hfweights_qwen_qwen3_4b, hfweights_z_lab_qwen3_4b_dflash_b16
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 OFFLINE=1
// RUN: make -f %S/Makefile full20 BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 OFFLINE=1 FULL20_OUTPUT=qwen3_4b_dflash_b16.full20.json
// RUN: FileCheck %s < qwen3_4b_dflash_b16.full20.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 20
// CHECK: "samples_per_dataset": 4
// CHECK: "speedup": {{[0-9]}}
