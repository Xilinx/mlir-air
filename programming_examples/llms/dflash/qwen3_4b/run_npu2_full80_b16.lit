// One pass for each engine, 16 prompts per dataset, cap2048/EOS on. Persistent
// inputs must be seeded with make download (also done by Download LLM Weights).
// Optional: enabled by the dedicated full80 Ninja target or lit -D dflash_full80=1.
// REQUIRES: dflash_full80
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_qwen3_4b_npu2, hfweights_qwen_qwen3_4b, hfweights_z_lab_qwen3_4b_dflash_b16
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 OFFLINE=1
// RUN: make -f %S/Makefile full80 BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 OFFLINE=1 FULL80_OUTPUT=qwen3_4b_dflash_b16.full80.json
// RUN: FileCheck %s < qwen3_4b_dflash_b16.full80.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 80
// CHECK: "speedup": {{[0-9]}}
