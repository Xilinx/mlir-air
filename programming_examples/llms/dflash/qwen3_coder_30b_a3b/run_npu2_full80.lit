// One pass for each engine, 16 prompts per dataset, cap2048/EOS on.
// Optional: enabled by the dedicated full80 Ninja target or lit -D dflash_full80=1.
// REQUIRES: dflash_full80
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_qwen_qwen3_coder_30b_a3b_instruct, hfweights_z_lab_qwen3_coder_30b_a3b_dflash
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-build
// RUN: make -f %S/Makefile full80 BUILD_DIR=dflash-build FULL80_OUTPUT=qwen3_coder_30b_a3b_dflash_b8.full80.json
// RUN: FileCheck %s < qwen3_coder_30b_a3b_dflash_b8.full80.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 80
// CHECK: "speedup": {{[0-9]}}
