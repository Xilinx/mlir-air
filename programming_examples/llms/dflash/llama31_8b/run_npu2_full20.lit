// Nightly pair: first four saved cases per dataset, one pass per engine,
// cap2048/EOS on. Uses the same persistent inputs and timing as Full80.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_llama_3_1_8b_npu2, hfweights_nousresearch_meta_llama_3_1_8b_instruct, hfweights_z_lab_llama3_1_8b_instruct_dflash_ultrachat
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-build OFFLINE=1
// RUN: make -f %S/Makefile full20 BUILD_DIR=dflash-build OFFLINE=1 FULL20_OUTPUT=llama31_8b_dflash_b8.full20.json
// RUN: FileCheck %s < llama31_8b_dflash_b8.full20.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 20
// CHECK: "samples_per_dataset": 4
// CHECK: "speedup": {{[0-9]}}
