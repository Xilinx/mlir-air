// One pass for each engine, 16 prompts per dataset, cap2048/EOS on. Persistent
// inputs must be seeded with make download (also done by Download LLM Weights).
// Optional: enabled by the dedicated full80 Ninja target or lit -D dflash_full80=1.
// REQUIRES: dflash_full80
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_llama_3_1_8b_npu2, hfweights_nousresearch_meta_llama_3_1_8b_instruct, hfweights_z_lab_llama3_1_8b_instruct_dflash_ultrachat
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-build OFFLINE=1
// RUN: make -f %S/Makefile full80 BUILD_DIR=dflash-build OFFLINE=1 FULL80_OUTPUT=llama31_8b_dflash_b8.full80.json
// RUN: FileCheck %s < llama31_8b_dflash_b8.full80.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 80
// CHECK: "speedup": {{[0-9]}}
