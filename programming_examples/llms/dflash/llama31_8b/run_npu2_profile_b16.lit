// PERF_MODEL: llama31_8b_dflash_b16
// Fixed GPU-explanation prompt, cap256, EOS on, greedy. Warm NPU
// prefill + the complete DFlash decode loop; paired studies are separate.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_llama_3_1_8b_npu2, hfweights_nousresearch_meta_llama_3_1_8b_instruct, hfweights_z_lab_llama3_1_8b_instruct_dflash_ultrachat
// RUN: make -f %S/Makefile weights compile BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 OFFLINE=1
// RUN: mkdir -p b16
// RUN: make -f %S/Makefile profile BUILD_DIR=dflash-b16-build BLOCK_SIZE=16 PROFILE_OUTPUT=b16/llama31_8b_dflash_b16.perf.json | tee b16/profile.txt
// RUN: FileCheck %s < b16/llama31_8b_dflash_b16.perf.json
// CHECK: "model": "llama31_8b_dflash_b16"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
