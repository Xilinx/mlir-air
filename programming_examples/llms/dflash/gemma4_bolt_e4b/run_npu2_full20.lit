// Nightly pair: first four saved cases per dataset, one pass per engine,
// cap2048/EOS on. Uses the same persistent inputs and timing as Full80.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_nemotron_3_5_bolt_e4b_npu2, hfweights_nvidia_nvidia_nemotron_3_5_bolt_e4b_4gb_dflash
// RUN: make -f %S/Makefile weights compile compile-baseline BUILD_DIR=dflash-build OFFLINE=1
// RUN: make -f %S/Makefile full20 BUILD_DIR=dflash-build OFFLINE=1 FULL20_OUTPUT=gemma4_bolt_e4b_dflash_b8.full20.json
// RUN: FileCheck %s < gemma4_bolt_e4b_dflash_b8.full20.json
// CHECK: "status": "completed"
// CHECK: "requests_per_engine": 20
// CHECK: "samples_per_dataset": 4
// CHECK: "speedup": {{[0-9]}}
