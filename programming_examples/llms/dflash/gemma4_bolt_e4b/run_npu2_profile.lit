// PERF_MODEL: gemma4_bolt_e4b_dflash_b8
// Fixed GPU-explanation prompt, cap256, EOS on, greedy/thinking off. Warm NPU
// prefill + the complete DFlash decode loop; paired studies are separate.
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_fastflowlm_nemotron_3_5_bolt_e4b_npu2, hfweights_nvidia_nvidia_nemotron_3_5_bolt_e4b_4gb_dflash
// RUN: make -f %S/Makefile weights compile BUILD_DIR=dflash-build OFFLINE=1
// RUN: make -f %S/Makefile profile BUILD_DIR=dflash-build PROFILE_OUTPUT=gemma4_bolt_e4b_dflash_b8.perf.json | tee profile.txt
// RUN: FileCheck %s < gemma4_bolt_e4b_dflash_b8.perf.json
// CHECK: "model": "gemma4_bolt_e4b_dflash_b8"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
