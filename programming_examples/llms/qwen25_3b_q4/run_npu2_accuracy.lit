//
// qwen25_3b_q4 accuracy: teacher-forced PPL + KL divergence of the NPU decode
// and prefill paths against the HF bf16 checkpoint and the same weights
// dequantized on wikitext-2 (verify/accuracy.py). Informational: this checks
// only that the measurement ran; run_npu2_verify.lit is the gate. The decode is
// built at its default context, which must cover the chunk length.
// Collected by check-programming-examples-llms-accuracy.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hf_token, hfweights_qwen_qwen2_5_3b_instruct, hfweights_fastflowlm_qwen2_5_3b_instruct_npu2, hfweights_ggml_org_ci
//
// RUN: mkdir -p test_peano_accuracy
// RUN: cd test_peano_accuracy
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile-decode PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=bf16 ACC_PATH=decode ACC_JSON=qwen25_3b_q4.bf16.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=bf16 ACC_PATH=prefill ACC_JSON=qwen25_3b_q4.bf16.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=dequant ACC_PATH=decode ACC_JSON=qwen25_3b_q4.dequant.decode.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile accuracy ACC_REF=dequant ACC_PATH=prefill ACC_JSON=qwen25_3b_q4.dequant.prefill.accuracy.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < qwen25_3b_q4.bf16.decode.accuracy.json
// RUN: FileCheck %s < qwen25_3b_q4.bf16.prefill.accuracy.json
// RUN: FileCheck %s < qwen25_3b_q4.dequant.decode.accuracy.json
// RUN: FileCheck %s < qwen25_3b_q4.dequant.prefill.accuracy.json
// CHECK: "kld_mean"
