//
// qwen25_7b_q4nx fused prefill (shared/fused_prefill): build it, then gate one chunk and
// a three-chunk prompt against the fp32 reference by logit cosine and first
// token. The weights are the HF checkpoint quantized onto the Q4NX grid at
// load, as the decode does.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_qwen_qwen2_5_7b_instruct
//
// RUN: mkdir -p test_npu2_verify_fused_prefill
// RUN: cd test_npu2_verify_fused_prefill
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=SHORT
// RUN: make -f %S/Makefile fused-prefill-long PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=LONG
//
// SHORT: prompt {{[0-9]+}} tokens (1 chunk(s))
// SHORT: GATE PASS
// LONG: prompt {{[0-9]+}} tokens (3 chunk(s))
// LONG: GATE PASS
