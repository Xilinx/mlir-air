//
// vllm-sr/d3-edge fused prefill compile-only test: builds the kernels and
// every op's insts of the shared fused_prefill device (d3_spec.py: the
// BF16-weight GEMMs at depth k and 2k and the noncausal head_dim-256
// attention). Weights are runtime buffers, so this needs no weight data.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22
//
// RUN: mkdir -p test_npu2_compile_fused_prefill
// RUN: cd test_npu2_compile_fused_prefill
// RUN: make -f %S/Makefile compile-fused-prefill PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
//
// CHECK: built 17 ops into
