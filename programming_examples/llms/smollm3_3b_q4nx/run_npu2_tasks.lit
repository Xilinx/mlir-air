//
// smollm3_3b_q4nx task scores: GSM8K and MMLU (lm-evaluation-harness) on the NPU and on
// the pinned HF checkpoint, paired per item (verify/lm_eval_npu.py).
// Informational: this checks only that the comparison ran; run_npu2_verify.lit
// is the gate. Collected by check-programming-examples-llms-tasks.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_huggingfacetb_smollm3_3b, hfweights_openai_gsm8k, hfweights_cais_mmlu
//
// RUN: make -f %S/Makefile weights BUILD_DIR=affine-build PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile compile P=1024 BUILD_DIR=affine-build PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks BUILD_DIR=affine-build TASKS=gsm8k TASKS_LIMIT=100 TASKS_JSON=smollm3_3b_q4nx.gsm8k.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile tasks BUILD_DIR=affine-build TASKS=mmlu TASKS_LIMIT=10 TASKS_JSON=smollm3_3b_q4nx.mmlu.tasks.json PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: FileCheck %s < smollm3_3b_q4nx.gsm8k.tasks.json
// RUN: FileCheck %s < smollm3_3b_q4nx.mmlu.tasks.json
// CHECK: "mcnemar_p"
