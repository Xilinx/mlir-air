//
// smollm3_3b_q4nx decode throughput vs context length, into
// smollm3_3b_q4nx.sweep.json.
// Synthetic: the context is set by sizing the KV cache, so this measures
// latency only; run_npu2_verify_p*.lit checks correctness.
// Swept to 32k: the model takes 64k positions.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_huggingfacetb_smollm3_3b
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode.py --model-name smollm3_3b_q4nx --makefile %S/Makefile --template-dir %S/build/sweep-decode --bench-model smollm3-3b --vocab-chunk-i2 18 --n-layers 36 --contexts 2048,8192,32768 --peano-dir %PEANO_INSTALL_DIR --xrt-dir %XRT_DIR --out smollm3_3b_q4nx.sweep.json
// RUN: FileCheck %s < smollm3_3b_q4nx.sweep.json
// CHECK: "model": "smollm3_3b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 2048
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
