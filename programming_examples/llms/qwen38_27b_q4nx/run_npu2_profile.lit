//
// Qwen3.8-27B TTFT and decode throughput, captured into qwen38_27b_q4nx.perf.json
// by bench/extract_perf.py. The prompt goes through the decode a token at a
// time.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_qwen3_8_27b_npu2
//
// RUN: mkdir -p test_peano_profile
// RUN: cd test_peano_profile
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile profile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR N_TOKENS=32 PROMPT="What is the capital of France?" | tee profile.txt
// RUN: %PYTHON %S/../bench/extract_perf.py profile.txt --model qwen38_27b_q4nx --n-tokens 32 --prompt "What is the capital of France?" > qwen38_27b_q4nx.perf.json
// RUN: FileCheck %s < qwen38_27b_q4nx.perf.json
// CHECK: "model": "qwen38_27b_q4nx"
// CHECK: "ttft_ms": {{[0-9]}}
// CHECK: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": {{[0-9]}}
