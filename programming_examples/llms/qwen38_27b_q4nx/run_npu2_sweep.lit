//
// Qwen3.8-27B decode tok/s vs context. The context is compiled in, so
// profile-decode builds once per point. 64k is the longest that builds: at
// 128k aircc fails in its wrap-and-stride canonicalization.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_fastflowlm_qwen3_8_27b_npu2
//
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode_runtime.py --model-name qwen38_27b_q4nx --makefile %S/Makefile --contexts 1024,4096,8192,32768,65536 --peano-dir %PEANO_INSTALL_DIR --out qwen38_27b_q4nx.sweep.json
// RUN: FileCheck %s < qwen38_27b_q4nx.sweep.json
// CHECK: "model": "qwen38_27b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 1024
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
// CHECK: "context_len": 65536
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
