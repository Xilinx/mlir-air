//
// Gemma4-E2B vision tower on NPU2 vs HF's Gemma4VisionModel + embedder, at the
// default 280-soft-token budget on the shapes image, and at 70 on a 640x480
// image whose patches do not fill whole attention key blocks. A 4:3 image at
// 140 and a 16:9 image at 280 have key block counts the attention pads to a
// 4-stage cascade: 19 blocks have no 2- or 3-stage split, and 38 are many.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_unsloth_gemma_4_e2b_it
//
// RUN: mkdir -p test_npu2_vision
// RUN: cd test_npu2_vision
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile vision PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
// RUN: %PYTHON -c "import sys; sys.path.insert(0, '%S'); import gemma4_vision_reference as R; R.make_test_image().resize((640, 480)).save('wide.png')"
// RUN: make -f %S/Makefile vision IMAGE=wide.png MST=70 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=WIDE
// RUN: %PYTHON -c "import sys; sys.path.insert(0, '%S'); import gemma4_vision_reference as R; R.make_test_image().resize((1024, 768)).save('r43.png'); R.make_test_image().resize((1920, 1080)).save('r169.png')"
// RUN: make -f %S/Makefile vision IMAGE=r43.png MST=140 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=R43
// RUN: make -f %S/Makefile vision IMAGE=r169.png PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=R169
//
// CHECK: patches 2520 (2304 valid)
// CHECK: PASS!
// WIDE: patches 630 (567 valid), GEMM rows 768, keys 576
// WIDE: PASS!
// R43: patches 1260 (1170 valid), GEMM rows 1280, keys 1280
// R43: PASS!
// R169: patches 2520 (2376 valid), GEMM rows 2560, keys 2560
// R169: PASS!
