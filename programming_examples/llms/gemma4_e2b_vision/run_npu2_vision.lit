//
// Gemma4-E2B vision tower on NPU2 vs HF's Gemma4VisionModel + embedder, at the
// default 280-soft-token budget on the shapes image, and at 70 on a 640x480
// image whose patches do not fill whole attention key blocks.
//
// REQUIRES: ryzen_ai_npu2, peano, hfweights_unsloth_gemma_4_e2b_it
//
// RUN: mkdir -p test_npu2_vision
// RUN: cd test_npu2_vision
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile vision PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s
// RUN: %PYTHON -c "import sys; sys.path.insert(0, '%S'); import gemma4_vision_reference as R; R.make_test_image().resize((640, 480)).save('wide.png')"
// RUN: make -f %S/Makefile vision IMAGE=wide.png MST=70 PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR | FileCheck %s --check-prefix=WIDE
//
// CHECK: patches 2520 (2304 valid)
// CHECK: PASS!
// WIDE: patches 630 (567 valid), GEMM rows 768, keys 576
// WIDE: PASS!
