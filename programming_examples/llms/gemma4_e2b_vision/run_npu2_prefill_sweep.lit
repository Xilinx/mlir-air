//
// Gemma4-E2B image turns: time to first token (vision tower + prefill) and
// decode tok/s at each image-token budget, written to
// gemma4_e2b_vision.image_sweep.json.
//
// REQUIRES: ryzen_ai_npu2, peano, peano_ge22, hfweights_fastflowlm_gemma4_e2b_it_npu2, hfweights_unsloth_gemma_4_e2b_it
//
// RUN: mkdir -p test_npu2_prefill_sweep
// RUN: cd test_npu2_prefill_sweep
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile compile PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: make -f %S/Makefile profile-image-sweep PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cat gemma4_e2b_vision.image_sweep.json | FileCheck %s
//
// CHECK: "axis": "image_tokens"
// CHECK: "image_budget": 70
// CHECK: "status": "ok"
// CHECK: "image_budget": 1120
// CHECK: "status": "ok"
