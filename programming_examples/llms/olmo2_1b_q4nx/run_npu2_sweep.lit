//
// olmo2_1b_q4nx decode throughput vs context length, into
// olmo2_1b_q4nx.sweep.json.
// Synthetic: the context is set by sizing the KV cache, so this measures
// latency only; run_npu2_verify_p*.lit checks correctness.
// Only 2k: the model takes 4k positions.
//
// REQUIRES: ryzen_ai_npu2, peano, llvm_link_pre23, hfweights_allenai_olmo_2_0425_1b_instruct
// RUN: mkdir -p test_peano_sweep
// RUN: cd test_peano_sweep
// RUN: %PYTHON %S/../bench/sweep_decode.py --model-name olmo2_1b_q4nx --makefile %S/Makefile --template-dir %S/build/sweep-decode --bench-model olmo2-1b --vocab-chunk-i2 14 --n-layers 16 --contexts 2048 --peano-dir %PEANO_INSTALL_DIR --xrt-dir %XRT_DIR --out olmo2_1b_q4nx.sweep.json
// RUN: FileCheck %s < olmo2_1b_q4nx.sweep.json
// CHECK: "model": "olmo2_1b_q4nx"
// CHECK: "axis": "context_len"
// CHECK: "context_len": 2048
// CHECK-NEXT: "decode_tokens_per_sec": {{[0-9]}}
