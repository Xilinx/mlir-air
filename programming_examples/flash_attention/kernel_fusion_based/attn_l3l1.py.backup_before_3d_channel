                            CallOp(
                                [], "div_gp_sp",
                                [sp_c2.result, gp_c2.result],
                            )
                            c0_out = ConstantOp(index_type, 0)
                            ChannelPut(
                                "Gp2L2", gp_c2.result,
                                indices=[tx, c0_out],
                                offsets=[0, 0, 0, 0],
                                sizes=[
                                    tile_size_q // M,
