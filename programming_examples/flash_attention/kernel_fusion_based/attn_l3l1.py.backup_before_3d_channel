    num_cascade_stages = args.num_cascade_stages
    num_q_tiles = 4

    mlir_module = build_module(
        lk=lk,
        lkp=lkp,
        lq=lq,
        lqp=lqp,
        dk=dk,
        dv=dv,
        num_q_tiles=num_q_tiles,
        num_cascade_stages=num_cascade_stages,
    )

    if args.print_module_only:
        print(mlir_module)
        exit(0)

    from air.backend.xrt_runner import XRTRunner
    from air.backend.xrt import XRTBackend
    from ml_dtypes import bfloat16

    INPUT_DATATYPE = OUTPUT_DATATYPE = bfloat16
    rng = np.random.default_rng(42)
    val_range = 3.0
    input_q = rng.uniform(0, val_range, (lq, dk)).astype(INPUT_DATATYPE)
    input_k = rng.uniform(0, val_range, (lk, dk)).astype(INPUT_DATATYPE)
    input_v = rng.uniform(0, val_range, (lk, dv)).astype(INPUT_DATATYPE)

    inv_sqrt_dk = 1.0 / sqrt(dk)
    Qf = input_q.astype(np.float32); Kf = input_k.astype(np.float32); Vf = input_v.astype(np.float32)
    scores = Qf @ Kf.T * inv_sqrt_dk
    mx = np.max(scores, axis=-1, keepdims=True)
    P = np.exp(scores - mx); P = P / np.sum(P, axis=-1, keepdims=True)
    sdpa_output = (P @ Vf).astype(OUTPUT_DATATYPE)

    if args.compile_mode == "compile-and-run":
        import filelock
        backend = XRTBackend(
            omit_while_true_loop=False,
            omit_pingpong="all",
            verbose=args.verbose,
            runtime_loop_tiling_sizes=[1, 1],
            output_format=args.output_format,
            instance_name="attention_bf16",
            target_device="npu2",
        )
        artifact = backend.compile(mlir_module)
        print("Compiled. Running on device...")
        with filelock.FileLock("/tmp/npu.lock"):
            invoker = backend.load(artifact)
            results = invoker(input_q, input_k, input_v, np.zeros((lq, dk), dtype=INPUT_DATATYPE))
        npu = results[3].reshape(lq, dk).astype(np.float32)
        ref = sdpa_output.astype(np.float32)
        backend.unload()
        c = float(np.corrcoef(npu.flatten(), ref.flatten())[0, 1])
        print(f"Correlation: {c:.6f}")
        print(f"{'PASS' if c > 0.99 else 'FAIL'}")
        exit(0 if c > 0.99 else 1)
    elif args.compile_mode == "compile-only":
        backend = XRTBackend(
