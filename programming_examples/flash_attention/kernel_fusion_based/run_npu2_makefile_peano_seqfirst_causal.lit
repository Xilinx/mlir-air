//
// Causal seq-first attention. --perf-iters runs the kernel repeatedly on one
// hardware context before the output is checked, so state the cores carry
// across runs is covered. The second case has a value dimension of two tiles.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p %t/dv64 %t/dv128
// RUN: cd %t/dv64 && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/dv64 && make -f %S/Makefile run SCRIPT=attn_npu2_seqfirst.py PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 EXTRA_PY_FLAGS="--causal --perf-iters 1" | FileCheck %s
// RUN: cd %t/dv128 && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/dv128 && make -f %S/Makefile run SCRIPT=attn_npu2_seqfirst.py PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 DV=128 EXTRA_PY_FLAGS="--causal --perf-iters 1" | FileCheck %s
// CHECK: PASS!
