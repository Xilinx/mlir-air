"""Flash attention with L3-to-L1 direct dataflow for Q/K.

Uses direct shim-to-tile DMA flows for Q and K (bypassing memtile),
with Q vertical broadcast and K horizontal broadcast via dma_packet
channels. V goes through memtile. Cascade merge follows the
cascade-after pattern from attn.py.

Design parameters:
  lk=2048, lkp=64, lq=2048, lqp=256, dk=64, dv=64
  num_q_tiles=4, num_cascade_stages=4, num_heads=1
  Non-causal only.
  Shared-buffer mode (lkp == dk).

DMA channel strategy (2 S2MM + 2 MM2S per compute tile):
  S2MM 0: QK channel (Q once, then K chunks via dma_packet)
  S2MM 1: V (per-stage via memtile)
  MM2S 0: Cascade or output
  MM2S 1: Cascade

Channel layout:
  QK: dma_packet, size=[num_q_tiles, 1],
      broadcast_shape=[num_q_tiles, num_cascade_stages]
      -> Q once per column, then K chunks interleaved by stage
  V:  per-stage VIn/V2L1 channels through memtile
  cascade: cascade type, size=[num_q_tiles, num_cascade_stages - 1]
  Gp2L2/GpOut: output from ty=0 tiles
"""

import argparse
from math import sqrt

import numpy as np

import air
from air.ir import *
from air.dialects.affine import apply as affine_apply
from air.dialects.air import *
from air.dialects.air import channel
from air.dialects.arith import ConstantOp
from air.dialects.memref import AllocOp, CollapseShapeOp, DeallocOp
from air.dialects.func import FuncOp, CallOp
from air.dialects.scf import for_ as scf_range, yield_
from air.dialects import scf, affine, arith


@module_builder
def build_module(
    lk=2048,
    lkp=64,
    lq=2048,
    lqp=256,
    dk=64,
    dv=64,
    num_q_tiles=4,
    num_cascade_stages=4,
    num_heads=2,
):
    """Build flash attention module with L3-to-L1 direct Q/K dataflow.

    Args:
        lk: Total K/V sequence length (default: 2048)
        lkp: K/V chunk size per tile (default: 64)
        lq: Total Q sequence length (default: 2048)
        lqp: Q chunk size per launch iteration (default: 256)
        dk: Key dimension (default: 64)
        dv: Value dimension (default: 64)
        num_q_tiles: Number of tiles to partition Q chunk into (default: 4)
        num_cascade_stages: Number of cascade pipeline stages (default: 4)
        num_heads: Number of attention heads (default: 2)
    """
    # Validate
    assert lq % lqp == 0, f"lq ({lq}) must be divisible by lqp ({lqp})"
    assert lqp % num_q_tiles == 0, f"lqp ({lqp}) must be divisible by num_q_tiles ({num_q_tiles})"
    assert lk % lkp == 0, f"lk ({lk}) must be divisible by lkp ({lkp})"
    assert lk % (lkp * num_cascade_stages) == 0, (
        f"lk ({lk}) must be divisible by lkp * num_cascade_stages ({lkp * num_cascade_stages})"
    )
    # assert num_heads % 2 == 0, f"num_heads ({num_heads}) must be even"

    enable_shared_buffers = lkp == dk
    assert enable_shared_buffers, "L3-to-L1 mode requires lkp == dk (shared buffers)"

    bf16 = Type.parse("bf16")
    i32 = IntegerType.get_signless(32)
    index_type = IndexType.get()

    mmul_m = mmul_k = mmul_n = 8

    # Derived parameters
    tile_size_q = lqp // num_q_tiles  # 64
    num_chunks = lk // lkp  # 32
    chunks_per_stage = num_chunks // num_cascade_stages  # 8
    num_lq_iters = lq // lqp  # 8
    # Total K chunks each tile receives via QK channel:
    # All stages' K chunks are interleaved, each tile receives all of them
    # but only processes its own stage's chunks.
    total_k_receives = num_cascade_stages * chunks_per_stage

    # Memory spaces
    l1_space = IntegerAttr.get(i32, 2)
    l2_space = IntegerAttr.get(i32, 1)

    # L1 MemRefTypes
    memref_q_l1 = MemRefType.get([tile_size_q, dk], bf16, memory_space=l1_space)
    memref_qk_l1 = MemRefType.get([lkp, dk], bf16, memory_space=l1_space)
    memref_g_2d_l1 = MemRefType.get([tile_size_q, lkp], bf16, memory_space=l1_space)
    memref_g_1d_l1 = MemRefType.get([tile_size_q * lkp], bf16, memory_space=l1_space)
    memref_gp_l1 = MemRefType.get([tile_size_q, dk], bf16, memory_space=l1_space)
    memref_up_l1 = MemRefType.get([tile_size_q, 1], bf16, memory_space=l1_space)
    memref_v_l1 = MemRefType.get([lkp, dk], bf16, memory_space=l1_space)

    # L2 MemRefTypes
    memref_v_l2 = MemRefType.get([lkp, dk], bf16, memory_space=l2_space)
    memref_output_l2 = MemRefType.get([lqp, dk], bf16, memory_space=l2_space)

    # L3 MemRefTypes (with head dimension)
    memref_q_l3 = MemRefType.get([num_heads, lq, dk], bf16)
    memref_k_l3 = MemRefType.get([num_heads, lk, dk], bf16)
    memref_v_l3 = MemRefType.get([num_heads, lk, dv], bf16)
    memref_out_l3 = MemRefType.get([num_heads, lq, dk], bf16)

    # External function declarations
    def external_func(name, inputs, outputs=None, link_with=None, visibility="private"):
        if outputs is None:
            outputs = []
        func_type = FunctionType.get(inputs, outputs)
        func = FuncOp(name=name, type=func_type, visibility=visibility)
        func.attributes["llvm.emit_c_interface"] = UnitAttr.get()
        if link_with:
            func.attributes["link_with"] = StringAttr.get(link_with)
        return func

    external_func("zero_fill_gp_bf16", [memref_gp_l1], link_with="attn.o")
    external_func("zero_fill_sp_bf16", [memref_up_l1], link_with="attn.o")
    external_func("zero_fill_g_bf16", [memref_g_1d_l1], link_with="attn.o")
    external_func("neg_inf_fill_up_bf16", [memref_up_l1], link_with="attn.o")
    external_func(
        "matmul_a_b_bf16",
        [memref_q_l1, memref_qk_l1, memref_g_1d_l1],
        link_with="attn.o",
    )
    external_func(
        "matmul_g_b_bf16",
        [memref_g_1d_l1, memref_v_l1, memref_gp_l1],
        link_with="attn.o",
    )
    external_func(
        "fused_softmax",
        [memref_g_1d_l1, memref_up_l1, memref_up_l1, memref_up_l1],
        link_with="attn.o",
    )
    external_func(
        "maximum_up_u_bf16", [memref_up_l1, memref_up_l1], link_with="attn.o"
    )
    external_func(
        "exp_up_minus_u",
        [memref_up_l1, memref_up_l1, memref_up_l1],
        link_with="attn.o",
    )
    external_func("mul_r_gp", [memref_up_l1, memref_gp_l1], link_with="attn.o")
    external_func(
        "accum_sp_r_s",
        [memref_up_l1, memref_up_l1, memref_up_l1],
        link_with="attn.o",
    )
    external_func(
        "vector_copy_32elems", [i32, memref_up_l1, memref_up_l1], link_with="attn.o"
    )
    external_func("copy_tile", [memref_qk_l1, memref_q_l1], link_with="attn.o")
    external_func("div_gp_sp", [memref_up_l1, memref_gp_l1], link_with="attn.o")
    external_func("add_gp_g", [memref_gp_l1, memref_gp_l1], link_with="attn.o")

    # ----------------------------------------------------------------
    # Channel declarations
    # ----------------------------------------------------------------

    # Q: L3-to-L1 direct, vertical broadcast per column to all stages
    chan_q = Channel(
        "Q2L1",
        size=[num_q_tiles, 1],
        broadcast_shape=[num_q_tiles, num_cascade_stages],
    )
    chan_q.attributes["channel_type"] = StringAttr.get("dma_packet")

    # K: L3-to-L1 direct, horizontal broadcast per stage to all columns
    chan_k = Channel(
        "K2L1",
        size=[1, num_cascade_stages],
        broadcast_shape=[num_q_tiles, num_cascade_stages],
    )
    chan_k.attributes["channel_type"] = StringAttr.get("dma_packet")

    # V: per-stage through memtile
    for s in range(num_cascade_stages):
        Channel(f"VIn_{s}", size=[1])
        Channel(f"V2L1_{s}", size=[1, 1], broadcast_shape=[num_q_tiles, 1])

    # Cascade: single multi-word cascade channel
    channel(
        "cascade",
        size=[num_q_tiles, num_cascade_stages - 1],
        channel_type="cascade",
    )

    # Output: L1-to-L2 gather, then L2-to-L3
    Channel("Gp2L2", size=[num_q_tiles, 1])
    Channel("GpOut", size=[1])

    # ----------------------------------------------------------------
    # Main attention function
    # ----------------------------------------------------------------
    @FuncOp.from_py_func(memref_q_l3, memref_k_l3, memref_v_l3, memref_out_l3)
    def attention_bf16(arg0, arg1, arg2, arg3):
        c_lq_iters = ConstantOp(index_type, num_lq_iters)
        c_num_head_groups = ConstantOp(index_type, max(1, num_heads // 2))

        @launch(
            operands=[arg0, arg1, arg2, arg3],
            sizes=[c_lq_iters, c_num_head_groups],
        )
        def launch_body(
            q_iter_idx, head_group_idx,
            q_iter_size, head_group_size,
            q_l3, k_l3, v_l3, out_l3,
        ):
            c0 = ConstantOp(index_type, 0)

            # Compute head indices from head group
            affine_map_head_base = AffineMap.get(
                0, 1,
                [AffineExpr.get_mul(
                    AffineSymbolExpr.get(0), AffineConstantExpr.get(2)
                )],
            )
            head_base = affine_apply(affine_map_head_base, [head_group_idx])

            # Affine map: lqp offset from Q iteration
            affine_map_q_offset = AffineMap.get(
                0, 1,
                [AffineExpr.get_mul(
                    AffineSymbolExpr.get(0), AffineConstantExpr.get(lqp * dk)
                )],
            )
            # Affine map: head * lq * dk + offset
            affine_map_head_q = AffineMap.get(
                0, 2,
                [AffineExpr.get_add(
                    AffineExpr.get_mul(
                        AffineSymbolExpr.get(0), AffineConstantExpr.get(lq * dk)
                    ),
                    AffineSymbolExpr.get(1),
                )],
            )
            # Affine map: head * lk * dk + row_offset * dk
            affine_map_head_k = AffineMap.get(
                0, 2,
                [AffineExpr.get_add(
                    AffineExpr.get_mul(
                        AffineSymbolExpr.get(0), AffineConstantExpr.get(lk * dk)
                    ),
                    AffineExpr.get_mul(
                        AffineSymbolExpr.get(1), AffineConstantExpr.get(dk)
                    ),
                )],
            )
            # Affine map: head * lk * dv
            affine_map_head_v = AffineMap.get(
                0, 1,
                [AffineExpr.get_mul(
                    AffineSymbolExpr.get(0), AffineConstantExpr.get(lk * dv)
                )],
            )

            launch_offset = affine_apply(affine_map_q_offset, [q_iter_idx])

            # ----------------------------------------------------------
            # Q puts: one per column (q_tile), broadcast to all stages
            # via QK dma_packet channel. Tiled for matmul_a_b.
            # ----------------------------------------------------------
            for qt in range(num_q_tiles):
                q_tile_off = qt * tile_size_q * dk
                q_head_off = affine_apply(
                    affine_map_head_q, [head_base, launch_offset]
                )
                ChannelPut(
                    "Q2L1", q_l3,
                    indices=[qt, 0],
                    offsets=[0, 0, 0, q_tile_off, q_head_off],
                    sizes=[dk // mmul_k, tile_size_q // mmul_m, mmul_m, mmul_k],
                    strides=[mmul_k, dk * mmul_k, dk, 1],
                )

            # ----------------------------------------------------------
            # K puts: all chunks for all stages, interleaved by stage.
            # Each chunk is broadcast to all q_tiles via broadcast_shape.
            # Order: for chunk in chunks_per_stage:
            #            for stage in num_cascade_stages:
            #                K[stage * cps * lkp + chunk * lkp : ...]
            # ----------------------------------------------------------
            for chunk in range(chunks_per_stage):
                for stage in range(num_cascade_stages):
                    k_row = stage * chunks_per_stage * lkp + chunk * lkp
                    k_row_const = ConstantOp(index_type, k_row)
                    k_head_off = affine_apply(
                        affine_map_head_k, [head_base, k_row_const]
                    )
                    # K horizontal broadcast: per-stage to all columns
                    ChannelPut(
                        "K2L1", k_l3,
                        indices=[0, stage],
                        offsets=[0, 0, 0, k_head_off],
                        sizes=[lkp // mmul_n, dk // mmul_k, mmul_n, mmul_k],
                        strides=[mmul_n * dk, mmul_k, dk, 1],
                    )

            # ----------------------------------------------------------
            # V puts: per-stage via VIn channels
            # ----------------------------------------------------------
            for stage in range(num_cascade_stages):
                v_head_off = affine_apply(affine_map_head_v, [head_base])
                v_stage_row_off = stage * chunks_per_stage * lkp
                ChannelPut(
                    f"VIn_{stage}", v_l3,
                    indices=[0],
                    offsets=[0, 0, v_stage_row_off, v_head_off],
                    sizes=[chunks_per_stage, lkp, dv],
                    strides=[lkp * dv, dv, 1],
                )

            # ----------------------------------------------------------
            # Output get
            # ----------------------------------------------------------
            out_head_off = affine_apply(
                affine_map_head_q, [head_base, launch_offset]
            )
            ChannelGet(
                "GpOut", out_l3,
                indices=[0],
                offsets=[0, out_head_off],
                sizes=[lqp, dk],
                strides=[dk, 1],
            )

            # ----------------------------------------------------------
            # Segment
            # ----------------------------------------------------------
            c1_seg_size = ConstantOp(index_type, 1)

            @segment(name="attn_seg", operands=[], sizes=[c1_seg_size, c1_seg_size])
            def segment_body(seg_x, seg_y, seg_sx, seg_sy):
                # L2 allocations for V (per-stage) and output
                v_l2_bufs = [AllocOp(memref_v_l2, [], []) for _ in range(num_cascade_stages)]
                output_l2 = AllocOp(memref_output_l2, [], [])

                # L1 allocations passed to herd
                q_saved_l1 = AllocOp(memref_q_l1, [], [])
                qk_buf_l1 = AllocOp(memref_qk_l1, [], [])
                up_l1 = AllocOp(memref_up_l1, [], [])
                sp_l1 = AllocOp(memref_up_l1, [], [])
                gp_l1 = AllocOp(memref_gp_l1, [], [])
                g_shared_l1 = AllocOp(memref_g_2d_l1, [], [])

                c_nq = ConstantOp(index_type, num_q_tiles)
                c_ns = ConstantOp(index_type, num_cascade_stages)
                c0_seg = ConstantOp(index_type, 0)

                # V streaming: L3-to-L2-to-L1 per stage, in chunk loop
                c_cps = ConstantOp(index_type, chunks_per_stage)
                for chunk_iter in scf_range(0, c_cps, 1):
                    for s in range(num_cascade_stages):
                        ChannelGet(f"VIn_{s}", v_l2_bufs[s].result, indices=[0])
                        ChannelPut(
                            f"V2L1_{s}", v_l2_bufs[s].result,
                            indices=[c0_seg, c0_seg],
                            offsets=[0, 0, 0, 0],
                            sizes=[dv // mmul_n, lkp // mmul_k, mmul_k, mmul_n],
                            strides=[mmul_n, dv * mmul_n, dv, 1],
                        )
                    yield_([])

                # Output gather from ty=0 tiles
                affine_map_tileq = AffineMap.get(
                    0, 1,
                    [AffineExpr.get_mul(
                        AffineSymbolExpr.get(0),
                        AffineConstantExpr.get(tile_size_q),
                    )],
                )
                par_out = scf.ForallOp(
                    lower_bounds=[0], upper_bounds=[num_q_tiles], steps=[1]
                )
                with InsertionPoint(par_out.body):
                    out_off = affine_apply(
                        affine_map_tileq, [par_out.induction_variables[0]]
                    )
                    ChannelGet(
                        "Gp2L2", output_l2.result,
                        indices=[par_out.induction_variables[0], 0],
                        offsets=[out_off, 0],
                        sizes=[tile_size_q, dv],
                        strides=[dv, 1],
                    )
                    scf.InParallelOp()

                # Output: L2-to-L3
                ChannelPut("GpOut", output_l2.result, indices=[0])

                # No Q/K segment-level ops -- direct L3-to-L1

                # ----------------------------------------------------------
                # Herd: [num_q_tiles, num_cascade_stages]
                # ----------------------------------------------------------
                @herd(
                    name="herd_0",
                    sizes=[c_nq, c_ns],
                    operands=[q_saved_l1, qk_buf_l1, up_l1, sp_l1, gp_l1, g_shared_l1],
                    link_with="attn.o",
                )
                def herd_body(
                    arg22, arg23, hsx, hsy,
                    arg26, arg27_qk, arg27, arg28, arg29, arg30,
                ):
                    # arg22 = tx (column / q_tile index)
                    # arg23 = ty (cascade stage index)
                    # arg26 = q_saved (Q copy in L1)
                    # arg27_qk = qk_buf (shared DMA receive buffer)
                    # arg27 = up buffer
                    # arg28 = sp buffer
                    # arg29 = Gp buffer
                    # arg30 = G_shared buffer (for get_gp_cascade)

                    # === INIT PHASE ===
                    # Receive Q via Q2L1 channel (vertical broadcast)
                    ChannelGet("Q2L1", arg27_qk, indices=[arg22, arg23])
                    CallOp([], "copy_tile", [arg27_qk, arg26])

                    # Init softmax state
                    CallOp([], "zero_fill_gp_bf16", [arg29])
                    CallOp([], "zero_fill_sp_bf16", [arg28])
                    CallOp([], "neg_inf_fill_up_bf16", [arg27])

                    # === COMPUTE LOOP ===
                    # Each tile receives only its own stage's K chunks via K2L1.
                    c_cps = ConstantOp(index_type, chunks_per_stage)
                    c0_loop = ConstantOp(index_type, 0)
                    c1_loop = ConstantOp(index_type, 1)

                    for chunk_idx in scf_range(c0_loop, c_cps, c1_loop):
                        # Receive K chunk (horizontal broadcast, per-stage)
                        ChannelGet("K2L1", arg27_qk, indices=[arg22, arg23])

                        # G = Q @ K^T
                        G_l1 = CollapseShapeOp(
                            memref_g_1d_l1, arg30, [[0, 1]]
                        )
                        CallOp([], "zero_fill_g_bf16", [G_l1])
                        CallOp([], "matmul_a_b_bf16", [arg26, arg27_qk, G_l1])

                        # V receive (per-stage channel)
                        v_alloc = AllocOp(memref_v_l1, [], [])
                        for s in range(num_cascade_stages):
                            if s == 0:
                                set_s = IntegerSet.get(
                                    0, 2,
                                    [AffineSymbolExpr.get(0),
                                     AffineSymbolExpr.get(1)],
                                    [False, True],
                                )
                            elif s == num_cascade_stages - 1:
                                set_s = IntegerSet.get(
                                    0, 2,
                                    [AffineSymbolExpr.get(0),
                                     AffineExpr.get_add(
                                         AffineSymbolExpr.get(1),
                                         AffineConstantExpr.get(-s))],
                                    [False, True],
                                )
                            else:
                                set_s = IntegerSet.get(
                                    0, 2,
                                    [AffineSymbolExpr.get(0),
                                     AffineExpr.get_add(
                                         AffineSymbolExpr.get(1),
                                         AffineConstantExpr.get(-s)),
                                     AffineExpr.get_add(
                                         AffineConstantExpr.get(s),
                                         AffineExpr.get_mul(
                                             AffineSymbolExpr.get(1),
                                             AffineConstantExpr.get(-1)))],
                                    [False, True, False],
                                )
                            if_s = affine.AffineIfOp(
                                set_s, cond_operands=[arg22, arg23]
                            )
                            with InsertionPoint(if_s.then_block):
                                ChannelGet(
                                    f"V2L1_{s}", v_alloc.result,
                                    indices=[arg22, c0_loop],
                                )
                                affine.AffineYieldOp([])

                        # Softmax + accumulate
                        c0_i32 = ConstantOp(i32, 0)
                        s_l1 = AllocOp(memref_up_l1, [], [])
                        r_l1 = AllocOp(memref_up_l1, [], [])
                        CallOp(
                            [], "fused_softmax",
                            [G_l1, arg27, s_l1.result, r_l1.result],
                        )
                        CallOp([], "mul_r_gp", [r_l1.result, arg29])
                        CallOp(
                            [], "matmul_g_b_bf16",
                            [G_l1, v_alloc.result, arg29],
                        )
                        CallOp(
                            [], "accum_sp_r_s",
                            [arg28, r_l1.result, s_l1.result],
                        )
                        CallOp(
                            [], "vector_copy_32elems",
                            [c0_i32, s_l1.result, arg28],
                        )
                        DeallocOp(s_l1)
                        DeallocOp(r_l1)
                        DeallocOp(v_alloc)

                        yield_([])

                    # === CASCADE MERGE (from attn.py lines 917-1143) ===
                    c1_h = ConstantOp(index_type, 1)
                    r_l1_c = AllocOp(memref_up_l1, [], [])

                    def get_gp_cascade():
                        # Shared-buffer mode: reuse G_shared (arg30)
                        return arg30

                    # affine.if for last cascade stage (ty == NS-1)
                    affine_set_last = IntegerSet.get(
                        0, 2,
                        [
                            AffineExpr.get_add(
                                AffineSymbolExpr.get(1),
                                AffineConstantExpr.get(-num_cascade_stages + 1),
                            ),
                            AffineSymbolExpr.get(0),
                            AffineExpr.get_add(
                                AffineConstantExpr.get(num_q_tiles - 1),
                                AffineExpr.get_mul(
                                    AffineSymbolExpr.get(0),
                                    AffineConstantExpr.get(-1),
                                ),
                            ),
                        ],
                        [True, False, False],
                    )
                    affine_if_last = affine.AffineIfOp(
                        affine_set_last, cond_operands=[arg22, arg23], has_else=True
                    )
                    with InsertionPoint(affine_if_last.then_block):
                        subi = arith.SubIOp(arg23, c1_h)
                        ChannelPut("cascade", arg29, indices=[arg22, subi])
                        ChannelPut("cascade", arg27, indices=[arg22, subi])
                        ChannelPut("cascade", arg28, indices=[arg22, subi])
                        affine.AffineYieldOp([])

                    with InsertionPoint(affine_if_last.else_block):
                        # Middle stages: 1 <= ty <= NS-2
                        affine_set_middle = IntegerSet.get(
                            0, 2,
                            [
                                AffineExpr.get_add(
                                    AffineSymbolExpr.get(1),
                                    AffineConstantExpr.get(-1),
                                ),
                                AffineExpr.get_add(
                                    AffineConstantExpr.get(num_cascade_stages - 2),
                                    AffineExpr.get_mul(
                                        AffineSymbolExpr.get(1),
                                        AffineConstantExpr.get(-1),
                                    ),
                                ),
                                AffineSymbolExpr.get(0),
                                AffineExpr.get_add(
                                    AffineConstantExpr.get(num_q_tiles - 1),
                                    AffineExpr.get_mul(
                                        AffineSymbolExpr.get(0),
                                        AffineConstantExpr.get(-1),
                                    ),
                                ),
                            ],
                            [False, False, False, False],
                        )
                        affine_if_middle = affine.AffineIfOp(
                            affine_set_middle,
                            cond_operands=[arg22, arg23],
                            has_else=True,
                        )
