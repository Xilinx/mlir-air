    lk = args.lk
    lkp = args.lkp
    lq = args.lq
    lqp = args.lqp
    dk = 64
    dv = 64
    num_heads = args.num_heads
    num_cascade_stages = args.num_cascade_stages
    num_q_tiles = 4

    mlir_module = build_module(
        lk=lk,
        lkp=lkp,
        lq=lq,
        lqp=lqp,
        dk=dk,
        dv=dv,
        num_q_tiles=num_q_tiles,
        num_cascade_stages=num_cascade_stages,
        num_heads=num_heads,
    )

    if args.print_module_only:
        print(mlir_module)
        exit(0)

    from air.backend.xrt_runner import XRTRunner
    from air.backend.xrt import XRTBackend
    from ml_dtypes import bfloat16

    INPUT_DATATYPE = OUTPUT_DATATYPE = bfloat16
    inv_sqrt_dk = 1.0 / sqrt(dk)

    rng = np.random.default_rng(42)
    val_range = 3.0
    input_q = rng.uniform(0, val_range, (num_heads, lq, dk)).astype(INPUT_DATATYPE)
    input_k = rng.uniform(0, val_range, (num_heads, lk, dk)).astype(INPUT_DATATYPE)
    input_v = rng.uniform(0, val_range, (num_heads, lk, dv)).astype(INPUT_DATATYPE)

    def sdpa_golden(Q, K, V, scale):
        """Standard scaled dot-product attention in f32."""
        scores = (Q.astype(np.float32) @ K.astype(np.float32).T) * scale
        m = np.max(scores, axis=-1, keepdims=True)
        exp_s = np.exp(scores - m)
        P = exp_s / np.sum(exp_s, axis=-1, keepdims=True)
        return (P @ V.astype(np.float32)).astype(OUTPUT_DATATYPE)

    sdpa_output = np.zeros((num_heads, lq, dv), dtype=OUTPUT_DATATYPE)
    for h in range(num_heads):
        sdpa_output[h] = sdpa_golden(input_q[h], input_k[h], input_v[h], inv_sqrt_dk)

    if args.compile_mode == "compile-and-run":
        runner = XRTRunner(
            omit_while_true_loop=False,
            omit_pingpong="all",
            verbose=args.verbose,
            runtime_loop_tiling_sizes=[1, 1],
            output_format=args.output_format,
            instance_name="attention_bf16",
        )
        exit(
            runner.run_test(
                mlir_module,
                inputs=[input_q, input_k, input_v],
                expected_outputs=[sdpa_output],
                atol=0.15,
                rtol=0.04,
                max_mismatch_percentage=2,
            )
        )
    elif args.compile_mode == "compile-only":
        backend = XRTBackend(
            omit_while_true_loop=False,
            omit_pingpong="all",
            verbose=args.verbose,
            runtime_loop_tiling_sizes=[1, 1],
            output_format=args.output_format,
            instance_name="attention_bf16",
            target_device="npu2",
        )
        module_function = backend.compile(mlir_module)
        print("Compilation complete.")
