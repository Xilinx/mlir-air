//
// Each kernel runs twice on one hardware context and the second output is
// checked, so state the cores carry across runs is covered. The second case
// has a head dimension of two tiles.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p %t/d64 %t/d128
// RUN: cd %t/d64 && make -f %S/Makefile clean
// RUN: cd %t/d64 && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=16384 LKP=64 LQ=16384 LQP=256 DK=64 DV=64 NUM_HEADS=2 EXTRA_PY_FLAGS="--causal --num-runs 2" | FileCheck %s
// RUN: cd %t/d128 && make -f %S/Makefile clean
// RUN: cd %t/d128 && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=512 LQ=512 DK=128 DV=128 NUM_HEADS=2 EXTRA_PY_FLAGS="--causal --num-runs 2" | FileCheck %s
// CHECK: PASS!
