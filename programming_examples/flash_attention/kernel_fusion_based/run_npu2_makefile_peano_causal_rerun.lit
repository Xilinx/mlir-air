//
// Causal attention on NPU2, run more than once on one hardware context with the
// last output checked, so state the cores carry across runs is covered. The
// first two cases use attn_npu2.py: four q blocks with GQA, then a head
// dimension of two tiles. The third uses attn_npu2_seqfirst.py, which takes
// --perf-iters for the same purpose.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p %t/gqa %t/d128 %t/seqfirst
// RUN: cd %t/gqa && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/gqa && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 NUM_HEADS=4 NUM_KV_HEADS=2 EXTRA_PY_FLAGS="--causal --num-runs 2" | FileCheck %s
// RUN: cd %t/d128 && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/d128 && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=512 LQ=512 DK=128 DV=128 NUM_HEADS=2 EXTRA_PY_FLAGS="--causal --num-runs 2" | FileCheck %s
// RUN: cd %t/seqfirst && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/seqfirst && make -f %S/Makefile run SCRIPT=attn_npu2_seqfirst.py PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 NUM_HEADS=4 NUM_KV_HEADS=2 EXTRA_PY_FLAGS="--causal --perf-iters 2" | FileCheck %s
// CHECK: PASS!
