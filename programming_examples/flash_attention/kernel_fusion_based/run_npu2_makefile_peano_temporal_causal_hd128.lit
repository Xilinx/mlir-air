// REQUIRES: ryzen_ai_npu2, peano
//
// The Llama-3.2-3B prefill shape at 1024: head_dim 128, four rounds of 256.
//
// RUN: mkdir -p test_temporal_causal_hd128
// RUN: cd test_temporal_causal_hd128
// RUN: make -f %S/Makefile clean
// RUN: make -f %S/Makefile run SCRIPT=attn_npu2_temporal_causal.py PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LKP=32 LQ=1024 LQP=256 DK=128 DV=128 NUM_Q_TILES=8 NUM_HEADS=24 NUM_KV_HEADS=8 EXTRA_PY_FLAGS="--causal --num-q-tiles 8 --num-heads-per-unroll 1" | FileCheck %s
// CHECK: PASS!
