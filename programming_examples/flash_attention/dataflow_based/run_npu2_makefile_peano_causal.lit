//
// Causal attention, run twice on one hardware context with the second output
// checked, so state the cores carry across runs is covered. The first case is
// the 3-stage pipeline skipping blocks above the diagonal; the second is the
// 4-stage pipeline passing tiles through MemTile buffers.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p %t/skip %t/stages4
// RUN: cd %t/skip && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/skip && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 EXTRA_PY_FLAGS="--causal --causal-skip --num-runs 2" | FileCheck %s
// RUN: cd %t/stages4 && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t/stages4 && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 EXTRA_PY_FLAGS="--causal --stages 4 --handoff l2 --num-runs 2" | FileCheck %s
// CHECK: PASS!
