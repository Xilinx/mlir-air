//
// Causal attention, the three operators run twice with the second output
// checked, so state the cores carry across runs is covered. 1024 keys gives
// each column two rows of cores.
//
// REQUIRES: ryzen_ai_npu2, peano
//
// RUN: mkdir -p %t
// RUN: cd %t && make -f %S/Makefile clean PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR
// RUN: cd %t && make -f %S/Makefile run PEANO_INSTALL_DIR=%PEANO_INSTALL_DIR LK=1024 LQ=1024 EXTRA_PY_FLAGS="--causal --num-runs 2" | FileCheck %s
// CHECK: PASS!
